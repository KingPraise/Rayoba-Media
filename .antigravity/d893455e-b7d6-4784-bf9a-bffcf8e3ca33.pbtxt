        replacement_content: "    client: \'Vortex Electric Limousines\',\n    year: \'2026\'\n  },\n  {\n    id: \'vanguard-editorial-codex\',\n    title: \'Vanguard Editorial Codex\',\n    category: \'Editorial\',\n    tag: \'PUBLISHING CRAFT\',\n    description: \'A leather-bound, gold-embossed annual anthology curating global vanguard thought leadership and heritage visual art.\',\n    longDescription: \'Commissioned by the Vanguard Society of London, this project involved designing a physical and immersive digital codex. We paired customized renaissance serif fonts with pristine Swiss editorial column grids, structuring a reading layout that turns statistical data into poetic movement. The gold leaf layout on standard heavy stock was mirrored beautifully on digital mobile showrooms.\',\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCkpnLo-Xra-g-7gTy1-cHIkSW82WJfZigrz1hsg34iqjH4xpm_Wk6aIJYC_16j55HLVuqheN5zEjzqvF3F_T1n2Q5k9U8LkFgn9smpVLKPClW-JcCRWEX_Z48ncPE1ZFj0EXW5Skqobp5FiXQNJfb26qF2fad2Ap9CUiZnfw3Q7qJg8kggb_tSGCUNnF_EISRJaZ8COQnGai2w2jsUVoZ-HygxhAI31_qpTien1MUaawTMmXm8JaEXviZ1cKKv3HXb8RVOYU3sFuQ\',\n    deliverables: [\n      \'Gold Embossed Hardcover Binding Blueprint\',\n      \'Exclusive Custom Typography Cut Alignments\',\n      \'Digital Reader Showroom with Spatial Transitions\'\n    ],\n    objectives: [\n      \'Bridge traditional physical printing mastery with lightweight web layout speed.\',\n      \'Sustain historic member pride while driving young curator engagement metrics.\'\n    ],\n    metrics: [\n      \'10,000 Limited copies sold-out entirely through private digital pre-order gates.\',\n      \'Aesthetic recognition from the London Association of Editorial Designers.\'\n    ],\n    client: \'Vanguard Society London\',\n    year: \'2025\'\n  },\n  {\n    id: \'zephyr-sovereign-showroom\',\n    title: \'Zephyr Sovereign Showroom\',\n    category: \'Digital Creative\',\n    tag: \'WEB OVERHAUL\',\n    description: \'A flawless, headless booking hub and aircraft customizer for elite private aviation charter services.\',\n    longDescription: \'We designed and constructed an advanced modular flight builder for elite air travelers. Users can configure spatial cabin environments with live material selections, selecting custom food itineraries and flight coordinates. We optimized client-side loads while delivering cinematic, dusk-lit panoramic aircraft visualizations.\',\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuAoLEN1N6rJpWktkABNEF5NeIMAzoAe07ocHgkKPNNKsCyMk44T6XjrvCIpTu8YgY8W-gpr0vE8O_2BEhv61WaySMoNlUSRKRS4yvX00kak-3VgR578Vl7qJIu7jp4bhYWuHPV9YVpB7nBpeH1LC0-3ELmh8lCxN-NyhbuxVdZPgLeLf4qdVjU15FoV_bQMco3OMJ4jv6yFeNAjkdQx6hgQY7KOFjJf6MCTU50udJc5UrRZYAkerGWZIEbiCGH8jmNRerDwFdUOB34\',\n    deliverables: [\n      \'Interactive Live Material Aircraft Customizer\',\n      \'Fast Booking Dashboard with Fluid Staggered Entrance\',\n      \'Atmospheric UI/UX Brand Design Set\'\n    ],\n    objectives: [\n      \'Eliminate form-filling delays, delivering an immediate high-end charter estimate.\',\n      \'Portray elite aerodynamic peace and spatial security visually.\'\n    ],\n    metrics: [\n      \'+185% increase in seasonal charter booking completions.\',\n      \'Average checkout interaction duration shortened from 12 minutes to 90 seconds.\',\n      \'Prestige digital interface of the Year nominee.\'\n    ],\n    client: \'Zephyr Jet Charters Ltd\',\n    year: \'2026\'\n  }\n];\n"
