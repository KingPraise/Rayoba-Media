  file_change {
    absolute_path_uri: "file:///src/components/ServicesPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { SERVICES } from \'../data\';\nimport { Palette, Globe, Share2, Mail, CheckCircle, Sparkles, Clock, Compass, HelpCircle, ArrowRight } from \'lucide-react\';\n\ninterface ServicesPageProps {\n  onNavigateToContact: () => void;\n}\n\nconst ICON_MAP: Record<string, any> = {\n  Palette,\n  Globe,\n  Share2,\n  Mail,\n};\n\n// Estimator options\ninterface EstimatorItem {\n  id: string;\n  name: string;\n  category: string;\n  weeks: number;\n  weight: number;\n  description: string;\n}\n\nconst ESTIMATOR_OPTIONS: EstimatorItem[] = [\n  { id: \'logo-crest\', name: \'Bespoke Brand Crest & Emblem\', category: \'Graphic Design\', weeks: 2, weight: 1.2, description: \'Hand-crafted royal identity seals and custom logmarks.\' },\n  { id: \'foil-collateral\', name: \'Gold-Foil Print Packaging Layouts\', category: \'Graphic Design\', weeks: 3, weight: 1.5, description: \'Bespoke tangible marketing and paper stationery design.\' },\n  { id: \'react-showroom\', name: \'Interactive React-Vite Digital Flagship\', category: \'Web Development\', weeks: 6, weight: 3.5, description: \'A highly tuned web flagship built on high performance.\' },\n  { id: \'custom-webgl\', name: \'Spatial Motion & WebGL Interactive Aura\', category: \'Web Development\', weeks: 4, weight: 2.5, description: \'Cinematic visual backdrops that react to client interaction.\' },\n  { id: \'grid-curation\', name: \'Editorial Social Grid Curation System\', category: \'Social Strategy\', weeks: 3, weight: 1.8, description: \'15-grid Instagram styling blueprints and high-contrast grids.\' },\n  { id: \'voice-copywriting\', name: \'Elite Sovereign Copywriting Lexicon\', category: \'Social Strategy\', weeks: 2, weight: 1.2, description: \'A custom vocabulary rulesbook written in elite style.\' },\n  { id: \'vip-newsletter\', name: \'Segmented VIP correspondence Pipelines\', category: \'Email Marketing\', weeks: 3, weight: 1.4, description: \'Automated newsletter cycles with premium converters.\' }\n];\n\nexport default function ServicesPage({ onNavigateToContact }: ServicesPageProps) {\n  const [selectedServiceId, setSelectedServiceId] = useState<string>(SERVICES[0].id);\n  const [selectedEstimatorIds, setSelectedEstimatorIds] = useState<string[]>([\'logo-crest\', \'react-showroom\']);\n\n  const activeService = SERVICES.find(s => s.id === selectedServiceId) || SERVICES[0];\n  const ActiveIcon = ICON_MAP[activeService.icon] || Palette;\n\n  // Toggle dynamic estimator options\n  const toggleEstimatorItem = (id: string) => {\n    setSelectedEstimatorIds(prev => \n      prev.includes(id) \n        ? prev.filter(item => item !== id)\n        : [...prev, id]\n    );\n  };\n\n  // Perform estimator calculation metrics in real-time\n  const calculateMetrics = () => {\n    const selectedItems = ESTIMATOR_OPTIONS.filter(opt => selectedEstimatorIds.includes(opt.id));\n    if (selectedItems.length === 0) {\n      return { weeks: 0, weightScore: 0, tier: \'Zero Scope\', rating: \'Select options below\' };\n    }\n    \n    // Timeline calculation based on peak project length + incremental additions\n    const peakWeeks = Math.max(...selectedItems.map(item => item.weeks));\n    const incrementalWeeks = selectedItems.length > 1 \n      ? (selectedItems.reduce((acc, current) => acc + current.weeks, 0) - peakWeeks) * 0.35\n      : 0;\n    const finalWeeksCount = Math.round(peakWeeks + incrementalWeeks);\n\n    // Sum overall score weights\n    const totalWeight = parseFloat(selectedItems.reduce((acc, current) => acc + current.weight, 0).toFixed(1));\n\n    let tier = \'Boutique Prestige\';\n    let rating = \'Focused identity and refined flagship presence.\';\n    if (totalWeight >= 7.0) {\n      tier = \'Dynastic Legacy Domain\';\n      rating = \'Full-spectrum visual empire with maximum digital conquest.\';\n    } else if (totalWeight >= 4.0) {\n      tier = \'Sovereign Hegemony\';\n      rating = \'Substantial presence establishing high executive industry confidence.\';\n    }\n\n    return {\n      weeks: finalWeeksCount,\n      weightScore: totalWeight,\n      tier,\n      rating\n    };\n  };\n\n  const metrics = calculateMetrics();\n\n  const handleConsultEstimator = () => {\n    // Navigate straight to Contact with standard click-through\n    onNavigateToContact();\n  };\n\n  return (\n    <div className=\"w-full relative min-h-screen pt-28 pb-16 flex flex-col justify-between\">\n      \n      {/* Editorial Header */}\n      <section className=\"max-w-7xl mx-auto px-6 md:px-12 w-full mt-8 md:mt-16 mb-20 text-left\">\n        <span className=\"font-sans text-xs md:text-sm text-royal-gold font-semibold tracking-[0.2em] mb-4 block uppercase p-1\">\n          Specialized Arsenals\n        </span>\n        <h1 className=\"font-display text-4xl sm:text-5xl lg:text-6xl font-black text-gray-900 dark:text-gilded-ivory leading-tight mb-6 max-w-4xl\">\n          Crafting Sovereign Digital Flagships and Visual Crests\n        </h1>\n        <p className=\"font-sans text-base md:text-lg text-gray-600 dark:text-gray-300 max-w-2xl leading-relaxed\">\n          Our services bypass standard mass-market procedures in favor of pure, bespoke, gridaligned creative. Hover and click below to inspect each structural department.\n        </p>\n      </section>\n\n      {/* Main Department Tabs Selection Block */}\n      <section className=\"max-w-7xl mx-auto px-6 md:px-12 w-full mb-28\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start\">\n          \n          {/* Department Lists Navigation */}\n          <div className=\"lg:col-span-4 flex flex-col space-y-3 text-left\">\n            <span className=\"font-sans text-xs font-semibold text-royal-gold uppercase tracking-widest pl-2 mb-2\">\n              Departments\n            </span>\n            {SERVICES.map((srv) => {\n              const IconComp = ICON_MAP[srv.icon] || Palette;\n              const isSelected = srv.id === selectedServiceId;\n              return (\n                <button\n                  key={srv.id}\n                  onClick={() => setSelectedServiceId(srv.id)}\n                  className={`w-full p-5 rounded-2xl border text-left flex items-center gap-4 transition-all duration-300 cursor-pointer ${\n                    isSelected \n                      ? \'bg-royal-gold text-deep-violet border-royal-gold shadow-lg shadow-secondary/5 scale-[1.01]\' \n                      : \'bg-white/40 dark:bg-black/10 border-royal-gold/10 hover:border-royal-gold/40 text-gray-800 dark:text-gray-300\'\n                  }`}\n                >\n                  <div className={`p-2.5 rounded-xl ${isSelected ? \'bg-deep-violet/10 text-deep-violet\' : \'bg-royal-gold/10 text-royal-gold\'}`}>\n                    <IconComp className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <h3 className=\"font-sans text-xs md:text-sm font-bold tracking-wide\">{srv.title}</h3>\n                    <p className=\"font-sans text-[10px] md:text-xs opacity-75 mt-0.5\">{srv.badge}</p>\n                  </div>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Department Contents Card */}\n          <div className=\"lg:col-span-8\">\n            <AnimatePresence mode=\"wait\">\n              <motion.div\n                key={selectedServiceId}\n                initial={{ opacity: 0, x: 15 }}\n                animate={{ opacity: 1, x: 0 }}\n                exit={{ opacity: 0, x: -15 }}\n                transition={{ duration: 0.3 }}\n                className=\"bg-white/80 dark:bg-zinc-950/20 md:p-10 p-6 rounded-3xl border border-royal-gold/20 backdrop-blur-md text-left flex flex-col justify-between min-h-[420px]\"\n              >\n                <div className=\"space-y-6\">\n                  <div className=\"flex flex-col sm:flex-row justify-between sm:items-center gap-4 pb-6 border-b border-royal-gold/10\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"p-3 bg-royal-gold/10 rounded-2xl text-royal-gold\">\n                        <ActiveIcon className=\"w-6 h-6\" />\n                      </div>\n                      <div>\n                        <span className=\"font-sans text-[10px] md:text-xs text-royal-gold font-semibold uppercase tracking-widest bg-royal-gold/10 px-2.5 py-1 rounded-full border border-royal-gold/10\">\n                          {activeService.badge}\n                        </span>\n                        <h2 className=\"font-display text-2xl md:text-3xl font-black text-gray-900 dark:text-gilded-ivory mt-1\">\n                          {activeService.title}\n                        </h2>\n                      </div>\n                    </div>\n                    <div className=\"flex sm:flex-col items-start gap-2 text-xs font-sans text-gray-500\">\n                      <div className=\"flex items-center gap-1.5 font-semibold text-royal-gold text-[10px] md:text-xs uppercase tracking-wider\">\n                        <Clock className=\"w-3.5 h-3.5\" />\n                        <span>Timeline: {activeService.timeline}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <p className=\"font-sans text-sm md:text-base text-gray-600 dark:text-gray-300 leading-relaxed\">\n                    {activeService.longDescription}\n                  </p>\n\n                  <div className=\"space-y-3 pt-4\">\n                    <h4 className=\"font-sans text-xs font-bold text-royal-gold uppercase tracking-wider\">\n                      Department Deliverables\n                    </h4>\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2\">\n                      {activeService.deliverables.map((deliv, idx) => (\n                        <div key={idx} className=\"flex items-start gap-2.5 text-xs md:text-sm text-gray-700 dark:text-gray-400\">\n                          <CheckCircle className=\"w-4 h-4 text-royal-gold mt-0.5 shrink-0\" />\n                          <span>{deliv}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"mt-8 pt-6 border-t border-royal-gold/10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs font-sans\">\n                  <div className=\"text-gray-500 flex items-start gap-1.5\">\n                    <Compass className=\"w-4 h-4 text-royal-gold shrink-0 mt-0.5 animate-spin\" style={{ animationDuration: \'8s\' }} />\n                    <span className=\"italic\">\n                      <span className=\"font-semibold text-royal-gold\">Methodology:</span> {activeService.methodology}\n                    </span>\n                  </div>\n                  <button \n                    onClick={onNavigateToContact}\n                    className=\"flex items-center gap-1 bg-royal-gold text-deep-violet uppercase tracking-wider text-[11px] font-bold px-4 py-2.5 rounded-xl cursor-pointer hover:bg-royal-gold/90 transition-all self-end\"\n                  >\n                    <span>Inquire Now</span>\n                    <ArrowRight className=\"w-3 h-3\" />\n                  </button>\n                </div>\n              </motion.div>\n            </AnimatePresence>\n          </div>\n\n        </div>\n      </section>\n\n      {/* Interactive Tool: Sovereign Deliverables Estimator */}\n      <section className=\"max-w-7xl mx-auto px-6 md:px-12 w-full mb-12\">\n        <div className=\"bg-white dark:bg-zinc-950 border border-royal-gold/20 rounded-[40px] xl:p-12 p-6 md:p-8 shadow-2xl shadow-secondary/5 text-left\">\n          \n          <div className=\"max-w-2xl text-left mb-10 pb-6 border-b border-royal-gold/10\">\n            <span className=\"font-sans text-xs text-royal-gold font-semibold uppercase tracking-widest block mb-2\">\n              Sovereign Utility Suite\n            </span>\n            <h2 className=\"font-display text-2xl md:text-3xl font-black text-gray-900 dark:text-gilded-ivory\">\n              The Deliverables Scope Estimator\n            </h2>\n            <p className=\"font-sans text-xs md:text-sm text-gray-600 dark:text-gray-400 mt-2\">\n              Check/uncheck desired prestige elements to simulate project size index calculations in real-time.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\">\n            \n            {/* Left selector checkboxes */}\n            <div className=\"lg:col-span-7 space-y-3.5\">\n              <span className=\"font-sans text-xs font-semibold text-royal-gold uppercase tracking-widest pl-1\">\n                Customize Deliverables Blueprints\n              </span>\n              <div className=\"space-y-3 mt-1\">\n                {ESTIMATOR_OPTIONS.map((opt) => {\n                  const isChecked = selectedEstimatorIds.includes(opt.id);\n                  return (\n                    <button\n                      key={opt.id}\n                      type=\"button\"\n                      onClick={() => toggleEstimatorItem(opt.id)}\n                      className={`w-full p-4.5 rounded-2xl border text-left flex items-start gap-4 transition-all duration-300 cursor-pointer ${\n                        isChecked \n                          ? \'bg-royal-gold/5 border-royal-gold dark:bg-royal-gold/5 shadow-sm\' \n                          : \'bg-transparent border-gray-200 dark:border-royal-gold/10 hover:border-royal-gold/30\'\n                      }`}\n                    >\n                      <div className=\"pt-0.5\">\n                        <input \n                          type=\"checkbox\"\n                          checked={isChecked}\n                          onChange={() => {}} // Swallowed since buttons manage clicks\n                          className=\"w-4.5 h-4.5 text-royal-gold focus:ring-royal-gold rounded bg-transparent border-royal-gold/30 cursor-pointer\" \n                        />\n                      </div>\n                      <div className=\"space-y-1\">\n                        <div className=\"flex flex-wrap items-center gap-2\">\n                          <h4 className=\"font-sans text-xs md:text-sm font-bold text-gray-950 dark:text-gilded-ivory\">\n                            {opt.name}\n                          </h4>\n                          <span className=\"font-sans text-[9px] bg-royal-gold/10 text-royal-gold px-2 py-0.5 rounded-full border border-royal-gold/10 uppercase tracking-widest font-semibold\">\n                            {opt.category}\n                          </span>\n                        </div>\n                        <p className=\"font-sans text-xs text-gray-500 dark:text-gray-400\">\n                          {opt.description}\n                        </p>\n                      </div>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* Right calculated outcome card */}\n            <div className=\"lg:col-span-5 sticky top-28 bg-off-white dark:bg-midnight-royal p-8 rounded-3xl border border-royal-gold/15 flex flex-col justify-between min-h-[400px]\">\n              <div className=\"space-y-8\">\n                <div className=\"flex items-center gap-2.5 text-royal-gold pb-4 border-b border-royal-gold/10\">\n                  <Sparkles className=\"w-5 h-5\" />\n                  <span className=\"font-sans text-xs font-bold uppercase tracking-widest\">\n                    Live Formulation Metrics\n                  </span>\n                </div>\n\n                <div className=\"space-y-6 text-left\">\n                  {/* Estimator Tier */}\n                  <div>\n                    <span className=\"font-sans text-[10px] text-gray-500 dark:text-gray-400 uppercase tracking-wider block\">\n                      Legacy Stature Tier\n                    </span>\n                    <strong className=\"font-display text-2xl font-black text-royal-gold block mt-1\">\n                      {metrics.tier}\n                    </strong>\n                    <p className=\"font-sans text-xs text-gray-600 dark:text-gray-400 mt-1 leading-relaxed\">\n                      {metrics.rating}\n                    </p>\n                  </div>\n\n                  {/* Calculated timeline & complexity stats */}\n                  <div className=\"grid grid-cols-2 gap-4 pt-4 border-t border-royal-gold/10\">\n                    <div>\n                      <span className=\"font-sans text-[10px] text-gray-500 dark:text-gray-400 uppercase tracking-wider block\">\n                        Estimated Scope\n                      </span>\n                      <strong className=\"font-sans text-xl md:text-2xl font-bold text-gray-950 dark:text-gilded-ivory block mt-1\">\n                        ~{metrics.weeks} Weeks\n                      </strong>\n                    </div>\n                    <div>\n                      <span className=\"font-sans text-[10px] text-gray-500 dark:text-gray-400 uppercase tracking-wider block\">\n                        Valuation Weight\n                      </span>\n                      <strong className=\"font-sans text-xl md:text-2xl font-bold text-gray-950 dark:text-gilded-ivory block mt-1\">\n                        {metrics.weightScore}x IDx\n                      </strong>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"mt-8 space-y-2\">\n                <button\n                  onClick={handleConsultEstimator}\n                  disabled={selectedEstimatorIds.length === 0}\n                  className=\"w-full py-4.5 bg-royal-gold disabled:opacity-50 text-deep-violet font-semibold uppercase tracking-wider text-xs rounded-2xl shadow-xl shadow-royal-gold/15 hover:scale-[1.02] active:scale-95 transition-all text-center flex items-center justify-center gap-2 cursor-pointer\"\n                >\n                  <span>Transmit Est blueprints</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n                <span className=\"font-sans text-[10px] text-center block text-gray-500\">\n                  Formulation is based on peak overlapping strategic dependencies.\n                </span>\n              </div>\n\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n    </div>\n  );\n}\n"
