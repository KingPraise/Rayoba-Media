    user_response: "let\'s create 4 more pages.\nArrange accordingly\npage 2\n<!DOCTYPE html>\n\n<html class=\"light\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Contact | Rayoba Media</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&amp;family=Plus+Jakarta+Sans:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: \'FILL\' 0, \'wght\' 400, \'GRAD\' 0, \'opsz\' 24;\n        }\n        .film-grain {\n            pointer-events: none;\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 9999;\n            opacity: 0.03;\n            background-image: url(\"https://www.transparenttextures.com/patterns/stardust.png\");\n        }\n        .glass-card {\n            backdrop-filter: blur(12px);\n            background: rgba(253, 251, 247, 0.7);\n            border: 1px solid rgba(212, 175, 55, 0.2);\n        }\n        .dark .glass-card {\n            background: rgba(10, 10, 11, 0.7);\n            border: 1px solid rgba(212, 175, 55, 0.1);\n        }\n        .magnetic-input:focus-within {\n            transform: translateY(-2px);\n            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n        }\n        @keyframes king-spark {\n            0% { transform: scale(0); opacity: 0; }\n            50% { transform: scale(1.2); opacity: 1; }\n            100% { transform: scale(1); opacity: 0.8; }\n        }\n        .spark-active::after {\n            content: \'\';\n            position: absolute;\n            bottom: -8px;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 4px;\n            height: 4px;\n            background: #D4AF37;\n            border-radius: 50%;\n            box-shadow: 0 0 8px #D4AF37;\n            animation: king-spark 0.6s ease-out forwards;\n        }\n        .extruded-shadow {\n            box-shadow: 8px 8px 24px rgba(46, 16, 101, 0.08), -4px -4px 16px rgba(255, 255, 255, 0.5);\n        }\n        .dark .extruded-shadow {\n            box-shadow: 8px 8px 24px rgba(0, 0, 0, 0.4), -2px -2px 12px rgba(212, 175, 55, 0.05);\n        }\n    </style>\n<script id=\"tailwind-config\">tailwind.config = {darkMode: \"class\", theme: {extend: {colors: {error: \"#ba1a1a\", \"on-secondary-container\": \"#4f3687\", background: \"#fcf8f9\", tertiary: \"#5d5e5f\", \"secondary-container\": \"#c0a5fe\", \"surface-bright\": \"#fcf8f9\", \"gilded-ivory\": \"#FDFBF7\", \"tertiary-container\": \"#b2b3b3\", outline: \"#7f7663\", \"surface-container\": \"#f0edee\", \"surface-variant\": \"#e5e2e3\", \"tertiary-fixed\": \"#e2e2e2\", \"inverse-primary\": \"#e9c349\", \"on-secondary-fixed-variant\": \"#503788\", \"on-tertiary-fixed-variant\": \"#454747\", \"royal-gold\": \"#D4AF37\", \"surface-container-low\": \"#f6f3f4\", \"tertiary-fixed-dim\": \"#c6c6c6\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1c1b1c\", \"on-tertiary-container\": \"#444546\", primary: \"#735c00\", \"outline-variant\": \"#d0c5af\", \"midnight-royal\": \"#0A0A0B\", \"inverse-on-surface\": \"#f3f0f1\", \"on-primary-fixed-variant\": \"#574500\", \"glass-stroke\": \"rgba(212, 175, 55, 0.2)\", \"deep-violet\": \"#2E1065\", \"surface-container-lowest\": \"#ffffff\", \"surface-tint\": \"#735c00\", \"on-error-container\": \"#93000a\", \"surface-dim\": \"#dcd9da\", \"surface-container-high\": \"#ebe7e8\", secondary: \"#6950a2\", \"secondary-fixed-dim\": \"#d1bcff\", surface: \"#fcf8f9\", \"on-primary-container\": \"#554300\", \"secondary-fixed\": \"#eaddff\", \"on-secondary\": \"#ffffff\", \"on-tertiary-fixed\": \"#1a1c1c\", \"primary-container\": \"#d4af37\", \"error-container\": \"#ffdad6\", \"on-primary-fixed\": \"#241a00\", \"inverse-surface\": \"#313031\", \"on-surface-variant\": \"#4d4635\", \"on-secondary-fixed\": \"#24005b\", \"primary-fixed\": \"#ffe088\", \"on-surface\": \"#1c1b1c\", \"on-primary\": \"#ffffff\", \"on-error\": \"#ffffff\", \"surface-container-highest\": \"#e5e2e3\", \"primary-fixed-dim\": \"#e9c349\"}, borderRadius: {DEFAULT: \"0.25rem\", lg: \"0.5rem\", xl: \"0.75rem\", full: \"9999px\"}, spacing: {gutter: \"24px\", \"container-max\": \"1280px\", \"margin-mobile\": \"20px\", \"margin-desktop\": \"80px\", unit: \"4px\"}, fontFamily: {\"display-md\": [\"Playfair Display\"], \"body-lg\": [\"Plus Jakarta Sans\"], \"label-lg\": [\"Plus Jakarta Sans\"], \"headline-lg\": [\"Playfair Display\"], \"display-lg\": [\"Playfair Display\"], \"headline-md\": [\"Playfair Display\"], \"body-md\": [\"Plus Jakarta Sans\"], \"headline-lg-mobile\": [\"Playfair Display\"], \"label-sm\": [\"Plus Jakarta Sans\"], headline: [\"Playfair Display\"], display: [\"Playfair Display\"], body: [\"Plus Jakarta Sans\"], label: [\"Plus Jakarta Sans\"]}, fontSize: {\"display-md\": [\"56px\", {lineHeight: \"64px\", letterSpacing: \"-0.01em\", fontWeight: \"700\"}], \"body-lg\": [\"18px\", {lineHeight: \"28px\", fontWeight: \"400\"}], \"label-lg\": [\"14px\", {lineHeight: \"20px\", letterSpacing: \"0.05em\", fontWeight: \"600\"}], \"headline-lg\": [\"40px\", {lineHeight: \"48px\", fontWeight: \"600\"}], \"display-lg\": [\"72px\", {lineHeight: \"80px\", letterSpacing: \"-0.02em\", fontWeight: \"700\"}], \"headline-md\": [\"24px\", {lineHeight: \"32px\", fontWeight: \"600\"}], \"body-md\": [\"16px\", {lineHeight: \"24px\", fontWeight: \"400\"}], \"headline-lg-mobile\": [\"32px\", {lineHeight: \"40px\", fontWeight: \"600\"}], \"label-sm\": [\"12px\", {lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"500\"}]}}}};</script>\n</head>\n<body class=\"bg-gilded-ivory dark:bg-midnight-royal text-on-background dark:text-gilded-ivory selection:bg-royal-gold/30 overflow-x-hidden\">\n<div class=\"film-grain\"></div>\n<!-- TopNavBar -->\n<nav class=\"fixed top-4 left-1/2 -translate-x-1/2 w-[calc(100%-48px)] max-w-container-max rounded-xl border border-glass-stroke bg-surface/80 dark:bg-midnight-royal/80 backdrop-blur-xl z-50 flex justify-between items-center px-gutter py-4 shadow-2xl shadow-secondary/10\">\n<div class=\"font-display-md text-display-md tracking-tighter text-royal-gold\">Rayoba Media</div>\n<div class=\"hidden md:flex items-center gap-8\">\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300 hover:scale-105 transition-transform duration-300\" href=\"#\">Home</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300 hover:scale-105 transition-transform duration-300\" href=\"#\">About</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300 hover:scale-105 transition-transform duration-300\" href=\"#\">Services</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300 hover:scale-105 transition-transform duration-300\" href=\"#\">Portfolio</a>\n<a class=\"font-label-lg text-label-lg text-primary dark:text-royal-gold font-bold border-b-2 border-royal-gold pb-1 relative spark-active\" href=\"#\">Contact</a>\n</div>\n<div class=\"flex items-center gap-4\">\n<button class=\"cursor-pointer active:scale-95 transition-all p-2 rounded-full hover:bg-royal-gold/10\" onclick=\"document.documentElement.classList.toggle(\'dark\')\">\n<span class=\"material-symbols-outlined text-royal-gold\" data-icon=\"light_mode\">light_mode</span>\n</button>\n<button class=\"md:hidden\">\n<span class=\"material-symbols-outlined text-royal-gold\" data-icon=\"menu\">menu</span>\n</button>\n</div>\n</nav>\n<main class=\"pt-40\">\n<!-- Hero Section -->\n<section class=\"max-w-container-max mx-auto px-margin-desktop mb-32\">\n<div class=\"flex flex-col md:flex-row gap-gutter items-start\">\n<div class=\"w-full md:w-1/2\" data-aos=\"fade-up\">\n<span class=\"font-label-lg text-label-lg text-royal-gold uppercase tracking-[0.2em] mb-4 block\">Royal Entry</span>\n<h1 class=\"font-display-lg text-display-lg md:text-display-lg text-midnight-royal dark:text-gilded-ivory leading-tight mb-8\">Begin Your Royal Journey</h1>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant max-w-md\">\n                        The first step to brand dominance begins with a conversation. Let us curate your legacy with technical precision and cinematic flair.\n                    </p>\n</div>\n<div class=\"w-full md:w-1/2 relative h-[400px] rounded-3xl overflow-hidden shadow-2xl\">\n<img alt=\"Rayoba Media Studio\" class=\"w-full h-full object-cover grayscale-[0.5] hover:grayscale-0 transition-all duration-700\" data-alt=\"A highly sophisticated, minimalist office interior with floor-to-ceiling windows overlooking a sunset cityscape. The room is decorated with editorial luxury pieces, including a large marble desk and gold-leaf accents. The lighting is warm and cinematic, casting long soft shadows. The overall aesthetic is one of quiet power, high-performance strategy, and premium professional excellence.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCJsOZYuQtwBX85gPMViaf-iYPBUlbcGXpRr36q-bVBcQU3VR2CHdNVOn4CEX1vJsf8KG4W2r6Uua9caRAixwTGshq-7cpTw17tZWaOW-84M8YOsQo_C-RpHABaLbIZ7dwHSdgr65mFd5Hat0FpkeNMoRtNT8GOMY784X6SqWgvx5jGDF-l2dY7FOjMjhBqSiO-UM7uYE0S8Q6uW2ZDQxbQ7b0IIdCBP3TijjRlDxUf1zzKWlyM7AHzgndAdNLvDTfmQSY5uk00q1I\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-midnight-royal/40 to-transparent\"></div>\n</div>\n</div>\n</section>\n<!-- Inquiry Form Section -->\n<section class=\"max-w-container-max mx-auto px-margin-desktop py-20 bg-surface-container-low/50 dark:bg-midnight-royal/30 rounded-[40px] mb-32 border border-glass-stroke/30\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-16\">\n<div class=\"md:col-span-4\">\n<h2 class=\"font-headline-lg text-headline-lg mb-6\">The Inquiry Form</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-10\">\n                        Share the vision of your project. Our consultants review each inquiry with meticulous attention to detail.\n                    </p>\n<div class=\"space-y-6\">\n<div class=\"flex items-center gap-4 p-4 glass-card rounded-xl extruded-shadow transition-all hover:scale-105 group\">\n<span class=\"material-symbols-outlined text-royal-gold\" data-icon=\"auto_awesome\">auto_awesome</span>\n<div>\n<p class=\"font-label-lg text-label-lg\">Priority Response</p>\n<p class=\"font-label-sm text-label-sm opacity-60\">Under 24 Hours</p>\n</div>\n</div>\n<div class=\"flex items-center gap-4 p-4 glass-card rounded-xl extruded-shadow transition-all hover:scale-105 group\">\n<span class=\"material-symbols-outlined text-royal-gold\" data-icon=\"verified\">verified</span>\n<div>\n<p class=\"font-label-lg text-label-lg\">Certified Quality</p>\n<p class=\"font-label-sm text-label-sm opacity-60\">Award Winning Craft</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"md:col-span-8\">\n<form class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" id=\"inquiryForm\">\n<div class=\"magnetic-input space-y-2 group\">\n<label class=\"font-label-lg text-label-lg opacity-60 group-focus-within:text-royal-gold transition-colors\">Your Full Name</label>\n<input class=\"w-full bg-transparent border-b border-outline-variant focus:border-royal-gold focus:ring-0 font-body-lg text-body-lg py-3 outline-none transition-all\" placeholder=\"e.g. Alexander Rayoba\" type=\"text\"/>\n</div>\n<div class=\"magnetic-input space-y-2 group\">\n<label class=\"font-label-lg text-label-lg opacity-60 group-focus-within:text-royal-gold transition-colors\">Professional Email</label>\n<input class=\"w-full bg-transparent border-b border-outline-variant focus:border-royal-gold focus:ring-0 font-body-lg text-body-lg py-3 outline-none transition-all\" placeholder=\"name@company.com\" type=\"email\"/>\n</div>\n<div class=\"magnetic-input space-y-2 md:col-span-2 group\">\n<label class=\"font-label-lg text-label-lg opacity-60 group-focus-within:text-royal-gold transition-colors\">Project Essence</label>\n<div class=\"flex flex-wrap gap-3 mt-4\">\n<button class=\"px-6 py-2 rounded-full border border-glass-stroke font-label-sm text-label-sm hover:bg-royal-gold hover:text-midnight-royal transition-all\" type=\"button\">Video Production</button>\n<button class=\"px-6 py-2 rounded-full border border-glass-stroke font-label-sm text-label-sm hover:bg-royal-gold hover:text-midnight-royal transition-all\" type=\"button\">Brand Strategy</button>\n<button class=\"px-6 py-2 rounded-full border border-glass-stroke font-label-sm text-label-sm hover:bg-royal-gold hover:text-midnight-royal transition-all\" type=\"button\">Digital Design</button>\n<button class=\"px-6 py-2 rounded-full border border-glass-stroke font-label-sm text-label-sm hover:bg-royal-gold hover:text-midnight-royal transition-all\" type=\"button\">Public Relations</button>\n</div>\n</div>\n<div class=\"magnetic-input space-y-2 md:col-span-2 group\">\n<label class=\"font-label-lg text-label-lg opacity-60 group-focus-within:text-royal-gold transition-colors\">Brief Description</label>\n<textarea class=\"w-full bg-transparent border-b border-outline-variant focus:border-royal-gold focus:ring-0 font-body-lg text-body-lg py-3 outline-none transition-all resize-none\" placeholder=\"Tell us about your brand goals...\" rows=\"4\"></textarea>\n</div>\n<div class=\"md:col-span-2 pt-6\">\n<button class=\"w-full md:w-auto px-12 py-4 bg-royal-gold text-deep-violet font-label-lg text-label-lg rounded-xl shadow-lg hover:shadow-royal-gold/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-3\" type=\"submit\">\n                                Send Inquiry\n                                <span class=\"material-symbols-outlined\" data-icon=\"send\">send</span>\n</button>\n</div>\n</form>\n</div>\n</div>\n</section>\n<!-- The Sanctum (Map/Location) -->\n<section class=\"mb-32\">\n<div class=\"max-w-container-max mx-auto px-margin-desktop mb-12\">\n<h2 class=\"font-headline-lg text-headline-lg\">The Sanctum</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Our creative headquarters in the heart of the metropolis.</p>\n</div>\n<div class=\"relative w-full h-[600px] overflow-hidden group\">\n<div class=\"absolute inset-0 bg-midnight-royal/20 pointer-events-none z-10\"></div>\n<!-- Mock 3D Abstract Representation -->\n<div class=\"w-full h-full bg-surface-container-highest dark:bg-midnight-royal relative\">\n<div class=\"absolute inset-0 opacity-40 dark:opacity-20 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-royal-gold/20 via-transparent to-transparent\"></div>\n<!-- Placeholder for Map/3D Canvas -->\n<div class=\"flex items-center justify-center h-full\">\n<div class=\"relative glass-card p-10 rounded-full border-2 border-royal-gold/30 animate-pulse\">\n<div class=\"absolute -top-20 left-1/2 -translate-x-1/2 bg-midnight-royal dark:bg-royal-gold text-gilded-ivory dark:text-midnight-royal px-6 py-2 rounded-lg font-label-lg text-label-lg whitespace-nowrap extruded-shadow\">\n                                487 Royal Plaza, New York\n                            </div>\n<span class=\"material-symbols-outlined text-[64px] text-royal-gold\" data-icon=\"location_on\" style=\"font-variation-settings: \'FILL\' 1;\">location_on</span>\n</div>\n</div>\n<!-- Geometric \"Buildings\" -->\n<div class=\"absolute bottom-0 left-0 w-full h-32 flex justify-around items-end opacity-20\">\n<div class=\"w-20 h-64 bg-royal-gold rounded-t-xl\"></div>\n<div class=\"w-32 h-96 bg-secondary rounded-t-xl\"></div>\n<div class=\"w-16 h-48 bg-royal-gold rounded-t-xl\"></div>\n<div class=\"w-24 h-80 bg-secondary rounded-t-xl\"></div>\n<div class=\"w-20 h-64 bg-royal-gold rounded-t-xl\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Direct Lines -->\n<section class=\"max-w-container-max mx-auto px-margin-desktop pb-32\">\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n<div class=\"p-10 rounded-3xl border border-glass-stroke hover:border-royal-gold transition-all duration-500 glass-card group\">\n<span class=\"material-symbols-outlined text-4xl text-royal-gold mb-6 block\" data-icon=\"mail\">mail</span>\n<h3 class=\"font-headline-md text-headline-md mb-2\">Editorial</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-6\">For press and creative inquiries.</p>\n<a class=\"font-label-lg text-label-lg text-royal-gold group-hover:underline\" href=\"mailto:editorial@rayoba.media\">editorial@rayoba.media</a>\n</div>\n<div class=\"p-10 rounded-3xl border border-glass-stroke hover:border-royal-gold transition-all duration-500 glass-card group\">\n<span class=\"material-symbols-outlined text-4xl text-royal-gold mb-6 block\" data-icon=\"call\">call</span>\n<h3 class=\"font-headline-md text-headline-md mb-2\">The Concierge</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-6\">Speak with our strategy team.</p>\n<a class=\"font-label-lg text-label-lg text-royal-gold group-hover:underline\" href=\"tel:+12125550198\">+1 (212) 555-0198</a>\n</div>\n<div class=\"p-10 rounded-3xl border border-glass-stroke hover:border-royal-gold transition-all duration-500 glass-card group\">\n<span class=\"material-symbols-outlined text-4xl text-royal-gold mb-6 block\" data-icon=\"diversity_3\">diversity_3</span>\n<h3 class=\"font-headline-md text-headline-md mb-2\">Partnerships</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-6\">Strategic alliances and growth.</p>\n<a class=\"font-label-lg text-label-lg text-royal-gold group-hover:underline\" href=\"#\">View Prospectus</a>\n</div>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer class=\"w-full relative bg-midnight-royal text-gilded-ivory border-t border-glass-stroke\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-gutter px-margin-desktop py-20 max-w-container-max mx-auto\">\n<div class=\"md:col-span-6\">\n<div class=\"font-display-lg text-display-lg text-royal-gold mb-6\">Rayoba Media</div>\n<p class=\"font-body-md text-body-md opacity-60 max-w-sm mb-12\">\n                    Architecting the future of visual storytelling through editorial excellence and technical precision.\n                </p>\n<div class=\"flex gap-6\">\n<a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Instagram</a>\n<a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">LinkedIn</a>\n<a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Twitter</a>\n<a class=\"text-royal-gold underline\" href=\"#\">Inquiry</a>\n</div>\n</div>\n<div class=\"md:col-span-3\">\n<h4 class=\"font-label-lg text-label-lg text-royal-gold mb-6 uppercase tracking-widest\">Office</h4>\n<p class=\"font-body-md text-body-md opacity-80 leading-relaxed\">\n                    487 Royal Plaza<br/>\n                    Suite 1200<br/>\n                    New York, NY 10013\n                </p>\n</div>\n<div class=\"md:col-span-3\">\n<h4 class=\"font-label-lg text-label-lg text-royal-gold mb-6 uppercase tracking-widest\">Legal</h4>\n<ul class=\"space-y-4 font-body-md text-body-md opacity-80\">\n<li><a class=\"hover:text-royal-gold transition-colors\" href=\"#\">Privacy Policy</a></li>\n<li><a class=\"hover:text-royal-gold transition-colors\" href=\"#\">Terms of Service</a></li>\n<li><a class=\"hover:text-royal-gold transition-colors\" href=\"#\">Accessibility</a></li>\n</ul>\n</div>\n<div class=\"md:col-span-12 pt-12 border-t border-glass-stroke/10 text-center opacity-40 font-body-md text-body-md\">\n                \302\251 2024 Rayoba Media. Editorial Excellence.\n            </div>\n</div>\n</footer>\n<script>\n        // Micro-interactions and effects\n        document.querySelectorAll(\'.magnetic-input\').forEach(container => {\n            const input = container.querySelector(\'input, textarea\');\n            container.addEventListener(\'mousemove\', (e) => {\n                if (window.innerWidth < 768) return;\n                const rect = container.getBoundingClientRect();\n                const x = e.clientX - rect.left - rect.width / 2;\n                const y = e.clientY - rect.top - rect.height / 2;\n                container.style.transform = `translate(${x * 0.05}px, ${y * 0.1}px)`;\n            });\n            container.addEventListener(\'mouseleave\', () => {\n                container.style.transform = \'translate(0, 0)\';\n            });\n        });\n\n        // Form submission animation\n        const form = document.getElementById(\'inquiryForm\');\n        form.addEventListener(\'submit\', (e) => {\n            e.preventDefault();\n            const btn = form.querySelector(\'button[type=\"submit\"]\');\n            const originalContent = btn.innerHTML;\n            btn.innerHTML = `<span class=\"material-symbols-outlined animate-spin\" data-icon=\"sync\">sync</span> Processing...`;\n            btn.disabled = true;\n            \n            setTimeout(() => {\n                btn.classList.replace(\'bg-royal-gold\', \'bg-emerald-600\');\n                btn.classList.replace(\'text-deep-violet\', \'text-white\');\n                btn.innerHTML = `<span class=\"material-symbols-outlined\" data-icon=\"check_circle\">check_circle</span> Inquiry Received`;\n                form.reset();\n                setTimeout(() => {\n                    btn.innerHTML = originalContent;\n                    btn.classList.replace(\'bg-emerald-600\', \'bg-royal-gold\');\n                    btn.classList.replace(\'text-white\', \'text-deep-violet\');\n                    btn.disabled = false;\n                }, 3000);\n            }, 1500);\n        });\n\n        // Toggle buttons active state\n        document.querySelectorAll(\'button[type=\"button\"]\').forEach(btn => {\n            btn.addEventListener(\'click\', () => {\n                btn.classList.toggle(\'bg-royal-gold\');\n                btn.classList.toggle(\'text-midnight-royal\');\n                btn.classList.toggle(\'border-royal-gold\');\n            });\n        });\n    </script>\n</body></html>"
    items {
      text: "let\'s create 4 more pages.\nArrange accordingly\npage 2\n<!DOCTYPE html>\n\n<html class=\"light\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Contact | Rayoba Media</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&amp;family=Plus+Jakarta+Sans:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: \'FILL\' 0, \'wght\' 400, \'GRAD\' 0, \'opsz\' 24;\n        }\n        .film-grain {\n            pointer-events: none;\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 9999;\n            opacity: 0.03;\n            background-image: url(\"https://www.transparenttextures.com/patterns/stardust.png\");\n        }\n        .glass-card {\n            backdrop-filter: blur(12px);\n            background: rgba(253, 251, 247, 0.7);\n            border: 1px solid rgba(212, 175, 55, 0.2);\n        }\n        .dark .glass-card {\n            background: rgba(10, 10, 11, 0.7);\n            border: 1px solid rgba(212, 175, 55, 0.1);\n        }\n        .magnetic-input:focus-within {\n            transform: translateY(-2px);\n            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n        }\n        @keyframes king-spark {\n            0% { transform: scale(0); opacity: 0; }\n            50% { transform: scale(1.2); opacity: 1; }\n            100% { transform: scale(1); opacity: 0.8; }\n        }\n        .spark-active::after {\n            content: \'\';\n            position: absolute;\n            bottom: -8px;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 4px;\n            height: 4px;\n            background: #D4AF37;\n            border-radius: 50%;\n            box-shadow: 0 0 8px #D4AF37;\n            animation: king-spark 0.6s ease-out forwards;\n        }\n        .extruded-shadow {\n            box-shadow: 8px 8px 24px rgba(46, 16, 101, 0.08), -4px -4px 16px rgba(255, 255, 255, 0.5);\n        }\n        .dark .extruded-shadow {\n            box-shadow: 8px 8px 24px rgba(0, 0, 0, 0.4), -2px -2px 12px rgba(212, 175, 55, 0.05);\n        }\n    </style>\n<script id=\"tailwind-config\">tailwind.config = {darkMode: \"class\", theme: {extend: {colors: {error: \"#ba1a1a\", \"on-secondary-container\": \"#4f3687\", background: \"#fcf8f9\", tertiary: \"#5d5e5f\", \"secondary-container\": \"#c0a5fe\", \"surface-bright\": \"#fcf8f9\", \"gilded-ivory\": \"#FDFBF7\", \"tertiary-container\": \"#b2b3b3\", outline: \"#7f7663\", \"surface-container\": \"#f0edee\", \"surface-variant\": \"#e5e2e3\", \"tertiary-fixed\": \"#e2e2e2\", \"inverse-primary\": \"#e9c349\", \"on-secondary-fixed-variant\": \"#503788\", \"on-tertiary-fixed-variant\": \"#454747\", \"royal-gold\": \"#D4AF37\", \"surface-container-low\": \"#f6f3f4\", \"tertiary-fixed-dim\": \"#c6c6c6\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1c1b1c\", \"on-tertiary-container\": \"#444546\", primary: \"#735c00\", \"outline-variant\": \"#d0c5af\", \"midnight-royal\": \"#0A0A0B\", \"inverse-on-surface\": \"#f3f0f1\", \"on-primary-fixed-variant\": \"#574500\", \"glass-stroke\": \"rgba(212, 175, 55, 0.2)\", \"deep-violet\": \"#2E1065\", \"surface-container-lowest\": \"#ffffff\", \"surface-tint\": \"#735c00\", \"on-error-container\": \"#93000a\", \"surface-dim\": \"#dcd9da\", \"surface-container-high\": \"#ebe7e8\", secondary: \"#6950a2\", \"secondary-fixed-dim\": \"#d1bcff\", surface: \"#fcf8f9\", \"on-primary-container\": \"#554300\", \"secondary-fixed\": \"#eaddff\", \"on-secondary\": \"#ffffff\", \"on-tertiary-fixed\": \"#1a1c1c\", \"primary-container\": \"#d4af37\", \"error-container\": \"#ffdad6\", \"on-primary-fixed\": \"#241a00\", \"inverse-surface\": \"#313031\", \"on-surface-variant\": \"#4d4635\", \"on-secondary-fixed\": \"#24005b\", \"primary-fixed\": \"#ffe088\", \"on-surface\": \"#1c1b1c\", \"on-primary\": \"#ffffff\", \"on-error\": \"#ffffff\", \"surface-container-highest\": \"#e5e2e3\", \"primary-fixed-dim\": \"#e9c349\"}, borderRadius: {DEFAULT: \"0.25rem\", lg: \"0.5rem\", xl: \"0.75rem\", full: \"9999px\"}, spacing: {gutter: \"24px\", \"container-max\": \"1280px\", \"margin-mobile\": \"20px\", \"margin-desktop\": \"80px\", unit: \"4px\"}, fontFamily: {\"display-md\": [\"Playfair Display\"], \"body-lg\": [\"Plus Jakarta Sans\"], \"label-lg\": [\"Plus Jakarta Sans\"], \"headline-lg\": [\"Playfair Display\"], \"display-lg\": [\"Playfair Display\"], \"headline-md\": [\"Playfair Display\"], \"body-md\": [\"Plus Jakarta Sans\"], \"headline-lg-mobile\": [\"Playfair Display\"], \"label-sm\": [\"Plus Jakarta Sans\"], headline: [\"Playfair Display\"], display: [\"Playfair Display\"], body: [\"Plus Jakarta Sans\"], label: [\"Plus Jakarta Sans\"]}, fontSize: {\"display-md\": [\"56px\", {lineHeight: \"64px\", letterSpacing: \"-0.01em\", fontWeight: \"700\"}], \"body-lg\": [\"18px\", {lineHeight: \"28px\", fontWeight: \"400\"}], \"label-lg\": [\"14px\", {lineHeight: \"20px\", letterSpacing: \"0.05em\", fontWeight: \"600\"}], \"headline-lg\": [\"40px\", {lineHeight: \"48px\", fontWeight: \"600\"}], \"display-lg\": [\"72px\", {lineHeight: \"80px\", letterSpacing: \"-0.02em\", fontWeight: \"700\"}], \"headline-md\": [\"24px\", {lineHeight: \"32px\", fontWeight: \"600\"}], \"body-md\": [\"16px\", {lineHeight: \"24px\", fontWeight: \"400\"}], \"headline-lg-mobile\": [\"32px\", {lineHeight: \"40px\", fontWeight: \"600\"}], \"label-sm\": [\"12px\", {lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"500\"}]}}}};</script>\n</head>\n<body class=\"bg-gilded-ivory dark:bg-midnight-royal text-on-background dark:text-gilded-ivory selection:bg-royal-gold/30 overflow-x-hidden\">\n<div class=\"film-grain\"></div>\n<!-- TopNavBar -->\n<nav class=\"fixed top-4 left-1/2 -translate-x-1/2 w-[calc(100%-48px)] max-w-container-max rounded-xl border border-glass-stroke bg-surface/80 dark:bg-midnight-royal/80 backdrop-blur-xl z-50 flex justify-between items-center px-gutter py-4 shadow-2xl shadow-secondary/10\">\n<div class=\"font-display-md text-display-md tracking-tighter text-royal-gold\">Rayoba Media</div>\n<div class=\"hidden md:flex items-center gap-8\">\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300 hover:scale-105 transition-transform duration-300\" href=\"#\">Home</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300 hover:scale-105 transition-transform duration-300\" href=\"#\">About</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300 hover:scale-105 transition-transform duration-300\" href=\"#\">Services</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300 hover:scale-105 transition-transform duration-300\" href=\"#\">Portfolio</a>\n<a class=\"font-label-lg text-label-lg text-primary dark:text-royal-gold font-bold border-b-2 border-royal-gold pb-1 relative spark-active\" href=\"#\">Contact</a>\n</div>\n<div class=\"flex items-center gap-4\">\n<button class=\"cursor-pointer active:scale-95 transition-all p-2 rounded-full hover:bg-royal-gold/10\" onclick=\"document.documentElement.classList.toggle(\'dark\')\">\n<span class=\"material-symbols-outlined text-royal-gold\" data-icon=\"light_mode\">light_mode</span>\n</button>\n<button class=\"md:hidden\">\n<span class=\"material-symbols-outlined text-royal-gold\" data-icon=\"menu\">menu</span>\n</button>\n</div>\n</nav>\n<main class=\"pt-40\">\n<!-- Hero Section -->\n<section class=\"max-w-container-max mx-auto px-margin-desktop mb-32\">\n<div class=\"flex flex-col md:flex-row gap-gutter items-start\">\n<div class=\"w-full md:w-1/2\" data-aos=\"fade-up\">\n<span class=\"font-label-lg text-label-lg text-royal-gold uppercase tracking-[0.2em] mb-4 block\">Royal Entry</span>\n<h1 class=\"font-display-lg text-display-lg md:text-display-lg text-midnight-royal dark:text-gilded-ivory leading-tight mb-8\">Begin Your Royal Journey</h1>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant max-w-md\">\n                        The first step to brand dominance begins with a conversation. Let us curate your legacy with technical precision and cinematic flair.\n                    </p>\n</div>\n<div class=\"w-full md:w-1/2 relative h-[400px] rounded-3xl overflow-hidden shadow-2xl\">\n<img alt=\"Rayoba Media Studio\" class=\"w-full h-full object-cover grayscale-[0.5] hover:grayscale-0 transition-all duration-700\" data-alt=\"A highly sophisticated, minimalist office interior with floor-to-ceiling windows overlooking a sunset cityscape. The room is decorated with editorial luxury pieces, including a large marble desk and gold-leaf accents. The lighting is warm and cinematic, casting long soft shadows. The overall aesthetic is one of quiet power, high-performance strategy, and premium professional excellence.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCJsOZYuQtwBX85gPMViaf-iYPBUlbcGXpRr36q-bVBcQU3VR2CHdNVOn4CEX1vJsf8KG4W2r6Uua9caRAixwTGshq-7cpTw17tZWaOW-84M8YOsQo_C-RpHABaLbIZ7dwHSdgr65mFd5Hat0FpkeNMoRtNT8GOMY784X6SqWgvx5jGDF-l2dY7FOjMjhBqSiO-UM7uYE0S8Q6uW2ZDQxbQ7b0IIdCBP3TijjRlDxUf1zzKWlyM7AHzgndAdNLvDTfmQSY5uk00q1I\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-midnight-royal/40 to-transparent\"></div>\n</div>\n</div>\n</section>\n<!-- Inquiry Form Section -->\n<section class=\"max-w-container-max mx-auto px-margin-desktop py-20 bg-surface-container-low/50 dark:bg-midnight-royal/30 rounded-[40px] mb-32 border border-glass-stroke/30\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-16\">\n<div class=\"md:col-span-4\">\n<h2 class=\"font-headline-lg text-headline-lg mb-6\">The Inquiry Form</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-10\">\n                        Share the vision of your project. Our consultants review each inquiry with meticulous attention to detail.\n                    </p>\n<div class=\"space-y-6\">\n<div class=\"flex items-center gap-4 p-4 glass-card rounded-xl extruded-shadow transition-all hover:scale-105 group\">\n<span class=\"material-symbols-outlined text-royal-gold\" data-icon=\"auto_awesome\">auto_awesome</span>\n<div>\n<p class=\"font-label-lg text-label-lg\">Priority Response</p>\n<p class=\"font-label-sm text-label-sm opacity-60\">Under 24 Hours</p>\n</div>\n</div>\n<div class=\"flex items-center gap-4 p-4 glass-card rounded-xl extruded-shadow transition-all hover:scale-105 group\">\n<span class=\"material-symbols-outlined text-royal-gold\" data-icon=\"verified\">verified</span>\n<div>\n<p class=\"font-label-lg text-label-lg\">Certified Quality</p>\n<p class=\"font-label-sm text-label-sm opacity-60\">Award Winning Craft</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"md:col-span-8\">\n<form class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" id=\"inquiryForm\">\n<div class=\"magnetic-input space-y-2 group\">\n<label class=\"font-label-lg text-label-lg opacity-60 group-focus-within:text-royal-gold transition-colors\">Your Full Name</label>\n<input class=\"w-full bg-transparent border-b border-outline-variant focus:border-royal-gold focus:ring-0 font-body-lg text-body-lg py-3 outline-none transition-all\" placeholder=\"e.g. Alexander Rayoba\" type=\"text\"/>\n</div>\n<div class=\"magnetic-input space-y-2 group\">\n<label class=\"font-label-lg text-label-lg opacity-60 group-focus-within:text-royal-gold transition-colors\">Professional Email</label>\n<input class=\"w-full bg-transparent border-b border-outline-variant focus:border-royal-gold focus:ring-0 font-body-lg text-body-lg py-3 outline-none transition-all\" placeholder=\"name@company.com\" type=\"email\"/>\n</div>\n<div class=\"magnetic-input space-y-2 md:col-span-2 group\">\n<label class=\"font-label-lg text-label-lg opacity-60 group-focus-within:text-royal-gold transition-colors\">Project Essence</label>\n<div class=\"flex flex-wrap gap-3 mt-4\">\n<button class=\"px-6 py-2 rounded-full border border-glass-stroke font-label-sm text-label-sm hover:bg-royal-gold hover:text-midnight-royal transition-all\" type=\"button\">Video Production</button>\n<button class=\"px-6 py-2 rounded-full border border-glass-stroke font-label-sm text-label-sm hover:bg-royal-gold hover:text-midnight-royal transition-all\" type=\"button\">Brand Strategy</button>\n<button class=\"px-6 py-2 rounded-full border border-glass-stroke font-label-sm text-label-sm hover:bg-royal-gold hover:text-midnight-royal transition-all\" type=\"button\">Digital Design</button>\n<button class=\"px-6 py-2 rounded-full border border-glass-stroke font-label-sm text-label-sm hover:bg-royal-gold hover:text-midnight-royal transition-all\" type=\"button\">Public Relations</button>\n</div>\n</div>\n<div class=\"magnetic-input space-y-2 md:col-span-2 group\">\n<label class=\"font-label-lg text-label-lg opacity-60 group-focus-within:text-royal-gold transition-colors\">Brief Description</label>\n<textarea class=\"w-full bg-transparent border-b border-outline-variant focus:border-royal-gold focus:ring-0 font-body-lg text-body-lg py-3 outline-none transition-all resize-none\" placeholder=\"Tell us about your brand goals...\" rows=\"4\"></textarea>\n</div>\n<div class=\"md:col-span-2 pt-6\">\n<button class=\"w-full md:w-auto px-12 py-4 bg-royal-gold text-deep-violet font-label-lg text-label-lg rounded-xl shadow-lg hover:shadow-royal-gold/20 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-3\" type=\"submit\">\n                                Send Inquiry\n                                <span class=\"material-symbols-outlined\" data-icon=\"send\">send</span>\n</button>\n</div>\n</form>\n</div>\n</div>\n</section>\n<!-- The Sanctum (Map/Location) -->\n<section class=\"mb-32\">\n<div class=\"max-w-container-max mx-auto px-margin-desktop mb-12\">\n<h2 class=\"font-headline-lg text-headline-lg\">The Sanctum</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Our creative headquarters in the heart of the metropolis.</p>\n</div>\n<div class=\"relative w-full h-[600px] overflow-hidden group\">\n<div class=\"absolute inset-0 bg-midnight-royal/20 pointer-events-none z-10\"></div>\n<!-- Mock 3D Abstract Representation -->\n<div class=\"w-full h-full bg-surface-container-highest dark:bg-midnight-royal relative\">\n<div class=\"absolute inset-0 opacity-40 dark:opacity-20 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-royal-gold/20 via-transparent to-transparent\"></div>\n<!-- Placeholder for Map/3D Canvas -->\n<div class=\"flex items-center justify-center h-full\">\n<div class=\"relative glass-card p-10 rounded-full border-2 border-royal-gold/30 animate-pulse\">\n<div class=\"absolute -top-20 left-1/2 -translate-x-1/2 bg-midnight-royal dark:bg-royal-gold text-gilded-ivory dark:text-midnight-royal px-6 py-2 rounded-lg font-label-lg text-label-lg whitespace-nowrap extruded-shadow\">\n                                487 Royal Plaza, New York\n                            </div>\n<span class=\"material-symbols-outlined text-[64px] text-royal-gold\" data-icon=\"location_on\" style=\"font-variation-settings: \'FILL\' 1;\">location_on</span>\n</div>\n</div>\n<!-- Geometric \"Buildings\" -->\n<div class=\"absolute bottom-0 left-0 w-full h-32 flex justify-around items-end opacity-20\">\n<div class=\"w-20 h-64 bg-royal-gold rounded-t-xl\"></div>\n<div class=\"w-32 h-96 bg-secondary rounded-t-xl\"></div>\n<div class=\"w-16 h-48 bg-royal-gold rounded-t-xl\"></div>\n<div class=\"w-24 h-80 bg-secondary rounded-t-xl\"></div>\n<div class=\"w-20 h-64 bg-royal-gold rounded-t-xl\"></div>\n</div>\n</div>\n</div>\n</section>\n<!-- Direct Lines -->\n<section class=\"max-w-container-max mx-auto px-margin-desktop pb-32\">\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n<div class=\"p-10 rounded-3xl border border-glass-stroke hover:border-royal-gold transition-all duration-500 glass-card group\">\n<span class=\"material-symbols-outlined text-4xl text-royal-gold mb-6 block\" data-icon=\"mail\">mail</span>\n<h3 class=\"font-headline-md text-headline-md mb-2\">Editorial</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-6\">For press and creative inquiries.</p>\n<a class=\"font-label-lg text-label-lg text-royal-gold group-hover:underline\" href=\"mailto:editorial@rayoba.media\">editorial@rayoba.media</a>\n</div>\n<div class=\"p-10 rounded-3xl border border-glass-stroke hover:border-royal-gold transition-all duration-500 glass-card group\">\n<span class=\"material-symbols-outlined text-4xl text-royal-gold mb-6 block\" data-icon=\"call\">call</span>\n<h3 class=\"font-headline-md text-headline-md mb-2\">The Concierge</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-6\">Speak with our strategy team.</p>\n<a class=\"font-label-lg text-label-lg text-royal-gold group-hover:underline\" href=\"tel:+12125550198\">+1 (212) 555-0198</a>\n</div>\n<div class=\"p-10 rounded-3xl border border-glass-stroke hover:border-royal-gold transition-all duration-500 glass-card group\">\n<span class=\"material-symbols-outlined text-4xl text-royal-gold mb-6 block\" data-icon=\"diversity_3\">diversity_3</span>\n<h3 class=\"font-headline-md text-headline-md mb-2\">Partnerships</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-6\">Strategic alliances and growth.</p>\n<a class=\"font-label-lg text-label-lg text-royal-gold group-hover:underline\" href=\"#\">View Prospectus</a>\n</div>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer class=\"w-full relative bg-midnight-royal text-gilded-ivory border-t border-glass-stroke\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-gutter px-margin-desktop py-20 max-w-container-max mx-auto\">\n<div class=\"md:col-span-6\">\n<div class=\"font-display-lg text-display-lg text-royal-gold mb-6\">Rayoba Media</div>\n<p class=\"font-body-md text-body-md opacity-60 max-w-sm mb-12\">\n                    Architecting the future of visual storytelling through editorial excellence and technical precision.\n                </p>\n<div class=\"flex gap-6\">\n<a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Instagram</a>\n<a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">LinkedIn</a>\n<a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Twitter</a>\n<a class=\"text-royal-gold underline\" href=\"#\">Inquiry</a>\n</div>\n</div>\n<div class=\"md:col-span-3\">\n<h4 class=\"font-label-lg text-label-lg text-royal-gold mb-6 uppercase tracking-widest\">Office</h4>\n<p class=\"font-body-md text-body-md opacity-80 leading-relaxed\">\n                    487 Royal Plaza<br/>\n                    Suite 1200<br/>\n                    New York, NY 10013\n                </p>\n</div>\n<div class=\"md:col-span-3\">\n<h4 class=\"font-label-lg text-label-lg text-royal-gold mb-6 uppercase tracking-widest\">Legal</h4>\n<ul class=\"space-y-4 font-body-md text-body-md opacity-80\">\n<li><a class=\"hover:text-royal-gold transition-colors\" href=\"#\">Privacy Policy</a></li>\n<li><a class=\"hover:text-royal-gold transition-colors\" href=\"#\">Terms of Service</a></li>\n<li><a class=\"hover:text-royal-gold transition-colors\" href=\"#\">Accessibility</a></li>\n</ul>\n</div>\n<div class=\"md:col-span-12 pt-12 border-t border-glass-stroke/10 text-center opacity-40 font-body-md text-body-md\">\n                \302\251 2024 Rayoba Media. Editorial Excellence.\n            </div>\n</div>\n</footer>\n<script>\n        // Micro-interactions and effects\n        document.querySelectorAll(\'.magnetic-input\').forEach(container => {\n            const input = container.querySelector(\'input, textarea\');\n            container.addEventListener(\'mousemove\', (e) => {\n                if (window.innerWidth < 768) return;\n                const rect = container.getBoundingClientRect();\n                const x = e.clientX - rect.left - rect.width / 2;\n                const y = e.clientY - rect.top - rect.height / 2;\n                container.style.transform = `translate(${x * 0.05}px, ${y * 0.1}px)`;\n            });\n            container.addEventListener(\'mouseleave\', () => {\n                container.style.transform = \'translate(0, 0)\';\n            });\n        });\n\n        // Form submission animation\n        const form = document.getElementById(\'inquiryForm\');\n        form.addEventListener(\'submit\', (e) => {\n            e.preventDefault();\n            const btn = form.querySelector(\'button[type=\"submit\"]\');\n            const originalContent = btn.innerHTML;\n            btn.innerHTML = `<span class=\"material-symbols-outlined animate-spin\" data-icon=\"sync\">sync</span> Processing...`;\n            btn.disabled = true;\n            \n            setTimeout(() => {\n                btn.classList.replace(\'bg-royal-gold\', \'bg-emerald-600\');\n                btn.classList.replace(\'text-deep-violet\', \'text-white\');\n                btn.innerHTML = `<span class=\"material-symbols-outlined\" data-icon=\"check_circle\">check_circle</span> Inquiry Received`;\n                form.reset();\n                setTimeout(() => {\n                    btn.innerHTML = originalContent;\n                    btn.classList.replace(\'bg-emerald-600\', \'bg-royal-gold\');\n                    btn.classList.replace(\'text-white\', \'text-deep-violet\');\n                    btn.disabled = false;\n                }, 3000);\n            }, 1500);\n        });\n\n        // Toggle buttons active state\n        document.querySelectorAll(\'button[type=\"button\"]\').forEach(btn => {\n            btn.addEventListener(\'click\', () => {\n                btn.classList.toggle(\'bg-royal-gold\');\n                btn.classList.toggle(\'text-midnight-royal\');\n                btn.classList.toggle(\'border-royal-gold\');\n            });\n        });\n    </script>\n</body></html>"
    }
  }
}
