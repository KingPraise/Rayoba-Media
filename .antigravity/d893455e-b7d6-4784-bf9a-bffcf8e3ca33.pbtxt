          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const x = e.clientX - rect.left - rect.width / 2;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const y = e.clientY - rect.top - rect.height / 2;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      setMousePosition({ x: x * 0.12, y: y * 0.12 });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
