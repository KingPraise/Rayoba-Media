  file_change {
    absolute_path_uri: "file:///src/data.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { Service, Project } from \'./types\';\n\nexport const SERVICES: Service[] = [\n  {\n    id: \'graphic-design\',\n    title: \'Graphic Design\',\n    description: \"Bespoke visual identities, luxury packaging, and editorial layouts that capture the essence of your brand\'s royalty.\",\n    longDescription: \'Our design philosophy is anchored in classical proportion and Swiss grid discipline. We build sovereign brand crests, editorial collateral, and packaging designs that convey quiet, undeniable prestige.\',\n    icon: \'Palette\',\n    badge: \'Bespoke Craft\',\n    deliverables: [\n      \'Visual Identity Guidelines & System Design\',\n      \'Custom Brand Crests, Logmarks, & Typography Pairings\',\n      \'Luxury Print Collateral & Sustainable Gold Foil Packaging\',\n      \'Bespoke Editorial & Magazine Layout Design\'\n    ],\n    timeline: \'4 - 6 Weeks\',\n    methodology: \'Rooted in heritage, designed for structural immortality.\'\n  },\n  {\n    id: \'web-dev\',\n    title: \'Web Development\',\n    description: \'High-performance digital flagship stores and immersive web experiences.\',\n    longDescription: \'We build digital showrooms that function flawlessly under extreme scale. By utilizing modern headless systems, WebGL rendering, and fluid responsive motion, we bridge high art and digital performance.\',\n    icon: \'Globe\',\n    badge: \'Digital Flagship\',\n    deliverables: [\n      \'Bespoke React-Vite Web Flagships & Native Showrooms\',\n      \'Fluid Micro-Animations & Responsive Spatial Interfaces\',\n      \'Performance Optimization & Interaction Auditing\',\n      \'Secure, High-Speed Editorial Content Management Systems\'\n    ],\n    timeline: \'6 - 10 Weeks\',\n    methodology: \'Lightweight code, heavy visual impact, fluid execution.\'\n  },\n  {\n    id: \'social-strategy\',\n    title: \'Social Strategy\',\n    description: \'Curated presence that turns followers into loyal subjects.\',\n    longDescription: \'Reject standard, noisy social posts. We curate high-concept campaigns, editorial grids, and sophisticated copywriting that translate your brand\342\200\231s prestige directly to digital circles.\',\n    icon: \'Share2\',\n    badge: \'Sovereign Presence\',\n    deliverables: [\n      \'Comprehensive Social Grid Curation & Strategy\',\n      \'High-Concept Video/Photography Production Templates\',\n      \'Elite Copywriting & Sovereign Tone of Voice Design\',\n      \'Select VIP/Ambassador Engagement Outlines\'\n    ],\n    timeline: \'Continuous / Retainer\',\n    methodology: \'Less volume, infinitely higher impact. Visual curation as an art-form.\'\n  },\n  {\n    id: \'email-marketing\',\n    title: \'Email Marketing\',\n    description: \'Sophisticated lifecycle automation and direct-to-royal communication that drives conversion.\',\n    longDescription: \'Your customer\342\200\231s inbox is a private gallery. We orchestrate highly tailored, editorial-first newsletters and private club automation workflows that drive recurring engagement without compromises.\',\n    icon: \'Mail\',\n    badge: \'Private Correspondence\',\n    deliverables: [\n      \'Editorial Newsletter Template Frameworks\',\n      \'High-Tier Segmented Loyalty Pipelines & Automations\',\n      \'Copywriting Guides for Discerning Customers\',\n      \'Behavioral Engagement Reporting & Strategic Diagnostics\'\n    ],\n    timeline: \'3 - 5 Weeks\',\n    methodology: \'Strict respect for recipient inbox authority, leading to elite conversion metrics.\'\n  }\n];\n\nexport const PROJECTS: Project[] = [\n  {\n    id: \'luminous-brand-identity\',\n    title: \'Luminous Brand Identity\',\n    category: \'Branding\',\n    tag: \'FEATURED WORK\',\n    description: \"A complete visual overhaul for a global venture firm, centering on the concept of \'Enlightened Capital\'.\",\n    longDescription: \'Enlightened Capital was built on backing avant-garde technologies and royal tier projects. Rayoba Media developed a modular, light-based visual signature starting from a physical hand-sketched seal and leading to a pixel-perfect, responsive virtual command center. We paired high-end serif layouts with minimalist typography to deliver immediate executive comfort.\',\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCkpnLo-Xra-g-7gTy1-cHIkSW82WJfZigrz1hsg34iqjH4xpm_Wk6aIJYC_16j55HLVuqheN5zEjzqvF3F_T1n2Q5k9U8LkFgn9smpVLKPClW-JcCRWEX_Z48ncPE1ZFj0EXW5Skqobp5FiXQNJfb26qF2fad2Ap9CUiZnfw3Q7qJg8kggb_tSGCUNnF_EISRJaZ8COQnGai2w2jsUVoZ-HygxhAI31_qpTien1MUaawTMmXm8JaEXviZ1cKKv3HXb8RVOYU3sFuQ\',\n    deliverables: [\n      \'Complete Visual Identity Guidelines\',\n      \'Bespoke Hand-Crafted Crest Emblem Design\',\n      \'Premium Golden Edge Call Cards & Editorial stationary\',\n      \'Interactive Digital Partner Dashboard\'\n    ],\n    objectives: [\n      \'Rebrand old venture architecture as a highly curated editorial experience.\',\n      \'Establish visual clues representing sovereign security, light, and foresight.\'\n    ],\n    metrics: [\n      \'300M+ Fund AUM fully committed within 15 business days of launch.\',\n      \'98% recall accuracy across targeted international partner surveys.\',\n      \'Recipient of the 2025 Global Design Guild Sovereign Medal.\'\n    ],\n    client: \'Enlightened Capital LLC\',\n    year: \'2025\'\n  },\n  {\n    id: \'sovereign-social-cloud\',\n    title: \'Sovereign Social Cloud\',\n    category: \'Digital Creative\',\n    tag: \'SOCIAL CAMPAIGN\',\n    description: \'Curating a prestigious digital presence for a luxury automotive brand, achieving 300% engagement growth.\',\n    longDescription: \'An atmospheric, moody campaign developed in Tokyo, capturing the fluid silhouettelike contours of the Vortex ultra-premium electric line. Using deep purple styling, custom golden neon backlights, and precise audio scoring, we repositioned electric vehicles as high-end kinetic art. This content strategy bypassed temporary gimmicks in favor of cinematic heritage.\',\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuAoLEN1N6rJpWktkABNEF5NeIMAzoAe07ocHgkKPNNKsCyMk44T6XjrvCIpTu8YgY8W-gpr0vE8O_2BEhv61WaySMoNlUSRKRS4yvX00kak-3VgR578Vl7qJIu7jp4bhYWuHPV9YVpB7nBpeH1LC0-3ELmh8lCxN-NyhbuxVdZPgLeLf4qdVjU15FoV_bQMco3OMJ4jv6yFeNAjkdQx6hgQY7KOFjJf6MCTU50udJc5UrRZYAkerGWZIEbiCGH8jmNRerDwFdUOB34\',\n    deliverables: [\n      \'Art Direction Setup in Neon & Shadow Palettes\',\n      \'Curation Strategy of a 15-Post Instagram Grid Core\',\n      \'Immersive Web Page for Private Pre-orders\',\n      \'Exquisite Sound Design Orchestrations\'\n    ],\n    objectives: [\n      \'Shift electric transportation from scientific terms to sensual, sovereign design language.\',\n      \'Generate high client desire from premium prospective buyers globally.\'\n    ],\n    metrics: [\n      \'3.2x Organic increase in client test-drive scheduler signups.\',\n      \'7.8M Combined views across high-prestige fashion and styling communities.\',\n      \'Pre-ordered the entire initial batch of 250 launch vehicles within an hour.\'\n    ],\n    client: \'Vortex Electric Limousines\',\n    year: \'2026\'\n  }\n];\n"
    }
