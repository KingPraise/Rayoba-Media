      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { motion } from \'motion/react\';\nimport Navbar from \'./components/Navbar\';\nimport Hero from \'./components/Hero\';\nimport OriginStory from \'./components/OriginStory\';\nimport BentoServices from \'./components/BentoServices\';\nimport Portfolio from \'./components/Portfolio\';\nimport LegacyPlanner from \'./components/LegacyPlanner\';\nimport Footer from \'./components/Footer\';\n\nexport default function App() {\n  \n  // Custom helper to scroll smoothly to targeted sections\n  const handleScrollToSection = (sectionId: string) => {\n    const el = document.getElementById(sectionId);\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\', block: \'start\' });\n    }\n  };\n\n  const handleOpenPlannerInquiry = () => {\n    handleScrollToSection(\'builder-section\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-off-white dark:bg-midnight-royal text-gray-800 dark:text-gilded-ivory selection:bg-royal-gold/30 transition-colors duration-500 relative flex flex-col font-sans\">\n      {/* Background ambient lighting */}\n      <div className=\"absolute top-0 inset-x-0 h-[800px] pointer-events-none overflow-hidden z-0\">\n        <div className=\"absolute top-[-200px] left-1/2 -translate-x-1/2 w-[600px] md:w-[900px] h-[400px] bg-royal-gold/5 dark:bg-royal-gold/10 blur-[130px] rounded-full\" />\n      </div>\n\n      {/* Cinematic Film Grain Overlay */}\n      <div className=\"film-grain fixed inset-0 z-[100] opacity-[0.02] dark:opacity-[0.035] pointer-events-none\" />\n\n      {/* Navigation Bar */}\n      <Navbar \n        onScrollToSection={handleScrollToSection} \n        onOpenPlanner={handleOpenPlannerInquiry}\n      />\n\n      {/* Hero Entrance Block */}\n      <div id=\"hero\" className=\"w-full\">\n        <Hero \n          onScrollToSection={handleScrollToSection} \n          onOpenPlanner={handleOpenPlannerInquiry}\n        />\n      </div>\n\n      {/* Staggered Sections Container */}\n      <main className=\"relative flex-grow\">\n        \n        {/* Origin story section */}\n        <motion.div\n          initial={{ opacity: 0 }}\n          whileInView={{ opacity: 1 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8 }}\n        >\n          <OriginStory />\n        </motion.div>\n\n        {/* Dynamic Service Arsenals */}\n        <motion.div\n          initial={{ opacity: 0 }}\n          whileInView={{ opacity: 1 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8 }}\n        >\n          <BentoServices />\n        </motion.div>\n\n        {/* Gorgeous custom portfolio cases */}\n        <motion.div\n          initial={{ opacity: 0 }}\n          whileInView={{ opacity: 1 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8 }}\n        >\n          <Portfolio />\n        </motion.div>\n\n        {/* Interactive Custom Stature Calculator / Legacy Planner */}\n        <motion.div\n          initial={{ opacity: 0 }}\n          whileInView={{ opacity: 1 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8 }}\n        >\n          <LegacyPlanner />\n        </motion.div>\n\n      </main>\n\n      {/* Premium footer */}\n      <Footer onScrollToSection={handleScrollToSection} />\n    </div>\n  );\n}\n"
