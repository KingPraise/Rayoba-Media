    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { Crown, Heart, Instagram, Linkedin, Twitter, Sparkles, Send } from \'lucide-react\';\n\ninterface FooterProps {\n  onScrollToSection: (sectionId: string) => void;\n}\n\nexport default function Footer({ onScrollToSection }: FooterProps) {\n  return (\n    <footer id=\"contact-footer\" className=\"bg-midnight-royal text-gilded-ivory w-full relative mt-16 border-t border-royal-gold/20 overflow-hidden\">\n      {/* Background radial highlight */}\n      <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-tr from-royal-gold/5 via-deep-violet/10 to-transparent blur-[120px] rounded-full pointer-events-none\" />\n\n      <div className=\"relative z-10 max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-24\">\n        \n        {/* Call to action section */}\n        <div className=\"text-center mb-16 space-y-8\">\n          <h2 className=\"font-display text-4xl sm:text-5xl md:text-6xl font-black text-gilded-ivory leading-tight\">\n            Ready to Illuminate <br className=\"hidden sm:block\" /> Your Brand?\n          </h2>\n          <p className=\"font-sans text-sm md:text-base text-gray-400 max-w-xl mx-auto leading-relaxed\">\n            Step into the light. Our team is ready to craft your brand\'s royal narrative and lead you to the pinnacle of your industry.\n          </p>\n          <div>\n            <button\n              onClick={() => onScrollToSection(\'builder-section\')}\n              className=\"inline-flex items-center justify-center bg-royal-gold hover:bg-royal-gold/90 text-deep-violet font-black px-10 py-4.5 rounded-2xl shadow-xl shadow-royal-gold/20 hover:scale-105 active:scale-95 transition-all cursor-pointer text-sm gap-2\"\n              id=\"magnetic-btn-footer\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              Let\'s Build Your Legacy\n            </button>\n          </div>\n        </div>\n\n        {/* Master Directory details */}\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 border-t border-royal-gold/10 pt-16 mt-16 text-left\">\n          \n          {/* Brand block */}\n          <div className=\"md:col-span-5 space-y-6\">\n            <button \n              onClick={() => onScrollToSection(\'hero\')}\n              className=\"flex items-center gap-2 font-display text-4xl font-bold text-royal-gold tracking-tight hover:opacity-80 transition-opacity\"\n            >\n              <Crown className=\"w-7 h-7\" />\n              <span>Rayoba</span>\n            </button>\n            <p className=\"font-sans text-xs md:text-sm text-gray-400 max-w-xs leading-relaxed\">\n              Editorial Excellence in Digital Strategy and Design. We synthesize light and sovereignty into uncompromised visual systems.\n            </p>\n          </div>\n\n          {/* Column Connect */}\n          <div className=\"md:col-span-2.5 space-y-4\">\n            <h4 className=\"font-display text-sm font-bold text-royal-gold uppercase tracking-widest\">Connect</h4>\n            <div className=\"flex flex-col space-y-2 text-xs font-sans text-gray-400\">\n              <a href=\"#\" className=\"hover:text-royal-gold transition-colors inline-flex items-center gap-1.5\">\n                <Instagram className=\"w-3.5 h-3.5\" /> Instagram\n              </a>\n              <a href=\"#\" className=\"hover:text-royal-gold transition-colors inline-flex items-center gap-1.5\">\n                <Linkedin className=\"w-3.5 h-3.5\" /> LinkedIn\n              </a>\n              <a href=\"#\" className=\"hover:text-royal-gold transition-colors inline-flex items-center gap-1.5\">\n                <Twitter className=\"w-3.5 h-3.5\" /> Twitter\n              </a>\n            </div>\n          </div>\n\n          {/* Column Inquiry */}\n          <div className=\"md:col-span-2.5 space-y-4\">\n            <h4 className=\"font-display text-sm font-bold text-royal-gold uppercase tracking-widest\">Inquiry</h4>\n            <div className=\"flex flex-col space-y-2 text-xs font-sans text-gray-400\">\n              <button onClick={() => onScrollToSection(\'portfolio\')} className=\"hover:text-royal-gold text-left transition-colors\">\n                Projects Showcase\n              </button>\n              <button onClick={() => onScrollToSection(\'builder-section\')} className=\"hover:text-royal-gold text-left transition-colors\">\n                Careers & Courts\n              </button>\n              <button onClick={() => onScrollToSection(\'builder-section\')} className=\"hover:text-royal-gold text-left transition-colors\">\n                Speaking & Consultations\n              </button>\n            </div>\n          </div>\n\n          {/* Bottom Copyright Block */}\n          <div className=\"md:col-span-12 flex flex-col md:flex-row justify-between items-center pt-12 border-t border-royal-gold/5 mt-12 text-xs text-gray-500 gap-4\">\n            <p className=\"font-sans\">\302\251 2026 Rayoba Media. Sovereign Digital Systems. All Rights Reserved.</p>\n            <p className=\"font-sans flex items-center gap-1\">\n              Constructed in high alignment with absolute design elegance.\n            </p>\n          </div>\n\n        </div>\n\n      </div>\n    </footer>\n  );\n}\n"
