      replacement_content: "  {\n    id: \'zephyr-sovereign-showroom\',\n    title: \'Zephyr Sovereign Showroom\',\n    category: \'Digital Creative\',\n    tag: \'WEB OVERHAUL\',\n    description: \'A flawless, headless booking hub and aircraft customizer for elite private aviation charter services.\',\n    longDescription: \'We designed and constructed an advanced modular flight builder for elite air travelers. Users can configure spatial cabin environments with live material selections, selecting custom food itineraries and flight coordinates. We optimized client-side loads while delivering cinematic, dusk-lit panoramic aircraft visualizations.\',\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuAoLEN1N6rJpWktkABNEF5NeIMAzoAe07ocHgkKPNNKsCyMk44T6XjrvCIpTu8YgY8W-gpr0vE8O_2BEhv61WaySMoNlUSRKRS4yvX00kak-3VgR578Vl7qJIu7jp4bhYWuHPV9YVpB7nBpeH1LC0-3ELmh8lCxN-NyhbuxVdZPgLeLf4qdVjU15FoV_bQMco3OMJ4jv6yFeNAjkdQx6hgQY7KOFjJf6MCTU50udJc5UrRZYAkerGWZIEbiCGH8jmNRerDwFdUOB34\',\n    deliverables: [\n      \'Interactive Live Material Aircraft Customizer\',\n      \'Fast Booking Dashboard with Fluid Staggered Entrance\',\n      \'Atmospheric UI/UX Brand Design Set\'\n    ],\n    objectives: [\n      \'Eliminate form-filling delays, delivering an immediate high-end charter estimate.\',\n      \'Portray elite aerodynamic peace and spatial security visually.\'\n    ],\n    metrics: [\n      \'+185% increase in seasonal charter booking completions.\',\n      \'Average checkout interaction duration shortened from 12 minutes to 90 seconds.\',\n      \'Prestige digital interface of the Year nominee.\'\n    ],\n    client: \'Zephyr Jet Charters Ltd\',\n    year: \'2026\'\n  },\n  {\n    id: \'aetherial-identity\',\n    title: \'Aetherial Identity\',\n    category: \'Branding\',\n    tag: \'LEGACY ARCHIVE\',\n    description: \'A visual legacy built for a new era of digital luxury.\',\n    longDescription: \'Aetherial Identity represents high heraldic mastery designed for high-end digital luxury. Rayoba Media curated custom typography grids, gold leaf packaging templates, and responsive online flagships that present immediate, commanding trust.\',\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuADs_6AxKDzxRA6shopxxF4RRAvQfVRvbJLDkphLtAqFkZ8JVTN5RYNsqpgtZVhjuUaKTBrodQ8ZD_t05NvVGibb9yuIcARCYE0ddGYC4aXvceu9iSSWxQCYvsh2-2eNjNqgwYSTmunUic_6duHY9VSNLnddKUvBNCn6hOYehZ7uSTCIFMbPn--Jf4uhs3WFf8ukuHiWSyd5k-VMx1vE2HoznhK5pXEqWfUQP45J_a3ItfeTZxUKIepT2M-RQEiywffvDN6hxXmUPU\',\n    deliverables: [\n      \'Gold Leaf Stationery Blueprint\',\n      \'Bespoke Crest Emblem Guidelines\',\n      \'Commanding Headless Showroom\'\n    ],\n    objectives: [\n      \'Establish unmatched digital authority.\',\n      \'Provide timeless design immune to design trends.\'\n    ],\n    metrics: [\n      \'100% Client Satisfaction Index\',\n      \'Aesthetic commendation from prestige design communities.\'\n    ],\n    client: \'Aetherial Holdings Co.\',\n    year: \'2025\'\n  },\n  {\n    id: \'pulse-growth\',\n    title: \'Pulse Growth\',\n    category: \'Strategy\',\n    tag: \'STRATEGIC BLUEPRINT\',\n    description: \'Data-driven performance scaled with surgical precision.\',\n    longDescription: \'Pulse Growth is an abstract glowing visualization of data-driven market conquests. We curated behavioral semiotics structures, interactive performance systems, and user flows that simplify customer decision paths from several minutes to immediate confidence.\',\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuDFqZc0yxxwoYA65ndAjWpleJIgPW4CcFVV96DaRME5vR0L6MCZnbN1BUEsdR3AJUzC8ST1Bpr1Hhxt9qFuTW888_BB2f81tOVQbGthw9_50j24o_NGtYH72eisz2z48PM9JdKREDFKjc9vMueKRqKBUZbpY23eAT2jk83NRKtnLTHXOqq6Tpm1fd3BkRyZlbup9xqjXJ8m63Jaub6gZ2pQwYkRIlH8MthhGYBF7iTifODrXUtbU7IJtMFiLzCB7Z-gYYMmtbXdnv8\',\n    deliverables: [\n      \'Performance Analysis Audit\',\n      \'Behavioral Semiotics Blueprint\',\n      \'High-Speed Client Converters\'\n    ],\n    objectives: [\n      \'Accelerate client flow sequences without visual compromise.\',\n      \'Engage high-tier global investors through crisp data representations.\'\n    ],\n    metrics: [\n      \'+300% Organic engagement expansion\',\n      \'Shortened decision flows by 75%\'\n    ],\n    client: \'Pulse Industries Group\',\n    year: \'2026\'\n  },\n  {\n    id: \'cinematic-story\',\n    title: \'Cinematic Story\',\n    category: \'Cinematography\',\n    tag: \'CINEMATIC CRAFT\',\n    description: \'Visual narratives that bridge emotion and authority.\',\n    longDescription: \'Cinematic Story is an editorial film showcase presenting high narrative pacing. Shot in wide, sun-drenched library halls with delicate dust motes and soft shadows, this project evokes centuries of scholarship, premium material quality, and sovereign brand legacy.\',\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCqll07XZqtCtM6wYLD5ja3ys8byhuqwoMrNUnUtQ3gATFiO82389-j_8gWJeRTQzwvLDbvLo9cF0zT5I_eo8-pW6DhlFn7jtx8K7zqDO4QC2_lY9UoYfL__WYQHiEnFAdYg9mb4D3ybhPIqnlSWSJjunf4lVia0V06_u2TFleN9RK47BQSCVmGrGtPRVHKAz9vNEDxDuX7IVLGUtVdogvACFXHZo6Zp20_qPkRaQlj0seZaWIx3JEGuxdc8wTfKgYmt5ejVWy0ESw\',\n    deliverables: [\n      \'Wide-Aspect Film Scoring Assets\',\n      \'Pacing and Direction Templates\',\n      \'Cinematographic Lighting Sequences\'\n    ],\n    objectives: [\n      \'Invoke absolute heritage trust.\',\n      \'Establish cinematic storytelling as the center of marketing campaigns.\'\n    ],\n    metrics: [\n      \'Award of the Year nominee\',\n      \'Commanded full stakeholder emotional resonance\'\n    ],\n    client: \'The Alexandria Syndicate\',\n    year: \'2024\'\n  }\n];"
