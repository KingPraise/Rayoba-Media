  user_input {
    user_response: "next page\n\n<!DOCTYPE html>\n\n<html class=\"scroll-smooth\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>About | Rayoba Media - The Royal Lineage</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">tailwind.config = {darkMode: \"class\", theme: {extend: {colors: {error: \"#ba1a1a\", \"on-secondary-container\": \"#4f3687\", background: \"#fcf8f9\", tertiary: \"#5d5e5f\", \"secondary-container\": \"#c0a5fe\", \"surface-bright\": \"#fcf8f9\", \"gilded-ivory\": \"#FDFBF7\", \"tertiary-container\": \"#b2b3b3\", outline: \"#7f7663\", \"surface-container\": \"#f0edee\", \"surface-variant\": \"#e5e2e3\", \"tertiary-fixed\": \"#e2e2e2\", \"inverse-primary\": \"#e9c349\", \"on-secondary-fixed-variant\": \"#503788\", \"on-tertiary-fixed-variant\": \"#454747\", \"royal-gold\": \"#D4AF37\", \"surface-container-low\": \"#f6f3f4\", \"tertiary-fixed-dim\": \"#c6c6c6\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1c1b1c\", \"on-tertiary-container\": \"#444546\", primary: \"#735c00\", \"outline-variant\": \"#d0c5af\", \"midnight-royal\": \"#0A0A0B\", \"inverse-on-surface\": \"#f3f0f1\", \"on-primary-fixed-variant\": \"#574500\", \"glass-stroke\": \"rgba(212, 175, 55, 0.2)\", \"deep-violet\": \"#2E1065\", \"surface-container-lowest\": \"#ffffff\", \"surface-tint\": \"#735c00\", \"on-error-container\": \"#93000a\", \"surface-dim\": \"#dcd9da\", \"surface-container-high\": \"#ebe7e8\", secondary: \"#6950a2\", \"secondary-fixed-dim\": \"#d1bcff\", surface: \"#fcf8f9\", \"on-primary-container\": \"#554300\", \"secondary-fixed\": \"#eaddff\", \"on-secondary\": \"#ffffff\", \"on-tertiary-fixed\": \"#1a1c1c\", \"primary-container\": \"#d4af37\", \"error-container\": \"#ffdad6\", \"on-primary-fixed\": \"#241a00\", \"inverse-surface\": \"#313031\", \"on-surface-variant\": \"#4d4635\", \"on-secondary-fixed\": \"#24005b\", \"primary-fixed\": \"#ffe088\", \"on-surface\": \"#1c1b1c\", \"on-primary\": \"#ffffff\", \"on-error\": \"#ffffff\", \"surface-container-highest\": \"#e5e2e3\", \"primary-fixed-dim\": \"#e9c349\"}, borderRadius: {DEFAULT: \"0.25rem\", lg: \"0.5rem\", xl: \"0.75rem\", full: \"9999px\"}, spacing: {gutter: \"24px\", \"container-max\": \"1280px\", \"margin-mobile\": \"20px\", \"margin-desktop\": \"80px\", unit: \"4px\"}, fontFamily: {\"display-md\": [\"Playfair Display\"], \"body-lg\": [\"Plus Jakarta Sans\"], \"label-lg\": [\"Plus Jakarta Sans\"], \"headline-lg\": [\"Playfair Display\"], \"display-lg\": [\"Playfair Display\"], \"headline-md\": [\"Playfair Display\"], \"body-md\": [\"Plus Jakarta Sans\"], \"headline-lg-mobile\": [\"Playfair Display\"], \"label-sm\": [\"Plus Jakarta Sans\"], headline: [\"Playfair Display\"], display: [\"Playfair Display\"], body: [\"Plus Jakarta Sans\"], label: [\"Plus Jakarta Sans\"]}, fontSize: {\"display-md\": [\"56px\", {lineHeight: \"64px\", letterSpacing: \"-0.01em\", fontWeight: \"700\"}], \"body-lg\": [\"18px\", {lineHeight: \"28px\", fontWeight: \"400\"}], \"label-lg\": [\"14px\", {lineHeight: \"20px\", letterSpacing: \"0.05em\", fontWeight: \"600\"}], \"headline-lg\": [\"40px\", {lineHeight: \"48px\", fontWeight: \"600\"}], \"display-lg\": [\"72px\", {lineHeight: \"80px\", letterSpacing: \"-0.02em\", fontWeight: \"700\"}], \"headline-md\": [\"24px\", {lineHeight: \"32px\", fontWeight: \"600\"}], \"body-md\": [\"16px\", {lineHeight: \"24px\", fontWeight: \"400\"}], \"headline-lg-mobile\": [\"32px\", {lineHeight: \"40px\", fontWeight: \"600\"}], \"label-sm\": [\"12px\", {lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"500\"}]}}}};</script>\n<style>.noise-overlay {\n    pointer-events: none;\n    position: fixed;\n    inset: 0;\n    z-index: 9999;\n    opacity: 0.03;\n    background-image: url(https://lh3.googleusercontent.com/aida-public/AB6AXuDIdmOAfvKNUnDIvOxcSRC_fYnX9RDL9Z4JK5xox9GjqR5QGvdJu7thb-c0ZLh9zm0mc4Uj8AzWRYflxePa6F1aRNTa2SQp924zTMKBb6NXmdNJ9L8Iqtv5Fkr7b8fIDT0q4d892L6SKWuFjJZheEgNC7nBFAYwl9G9s5kihuDue3nt7KDdWMfJf8xber4UWYfn0SDmczGfF_r6iAzVpVupwnSV5LKPpUTzV_IdBLAN8kv3gzecsPb2v0H5K327GTPrqumGvBU52as)\n    }\n.reveal {\n    opacity: 0;\n    transform: translatey(30px);\n    transition: all 0.8s ease-out\n    }\n.reveal.active {\n    opacity: 1;\n    transform: translatey(0)\n    }\n.glass-card {\n    background: rgba(253, 251, 247, 0.4);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(212, 175, 55, 0.2);\n    box-shadow: 0 10px 30px -10px rgba(46, 16, 101, 0.05)\n    }\n.kinetic-text span {\n    display: inline-block;\n    animation: text-reveal 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;\n    opacity: 0;\n    transform: translatey(100%)\n    }\n@keyframes text-reveal {\n    to {\n        opacity: 1;\n        transform: translateY(0);\n        }\n    }\n.royal-glow:hover {\n    box-shadow: 0 0 20px rgba(212, 175, 55, 0.3)\n    }</style>\n</head>\n<body class=\"bg-background text-on-background font-body-md overflow-x-hidden\">\n<div class=\"noise-overlay\"></div>\n<!-- Shared Component: TopNavBar -->\n<nav class=\"fixed top-4 left-1/2 -translate-x-1/2 w-[calc(100%-48px)] max-w-container-max rounded-xl border border-glass-stroke bg-surface/80 dark:bg-midnight-royal/80 backdrop-blur-xl shadow-2xl shadow-secondary/10 flex justify-between items-center px-gutter py-4 z-50\">\n<div class=\"flex items-center gap-2\">\n<img alt=\"Rayoba Logo\" class=\"h-8 md:h-10 hover:scale-105 transition-transform duration-300 cursor-pointer\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuACnOZOoW6wmJpLQmCWkN3BBRPXLkOm0qm0XlxCox0gUZpexlFDizTA1Z4OceMxj7UfLF98cSLs94cnQ3kgdc3ADrREcOzrZ8NucGUIzRgcGUlPOhdea4N8eydmmiNlYfyzRwoV1nOpIiz55fIAb3gkj0Jhb-oBNlaWSduyD52MWbscqTlbH0qEawlBHV7Jj6vBeeSRf1rqwPtFsG7APAkGjX-yYyyWYcAVtYX98GhfHia8t49STrpcgxGhF21hAVAkj1D_muZUHn8\"/>\n<span class=\"font-display-md text-display-md tracking-tighter text-royal-gold hidden md:block\">Rayoba Media</span>\n</div>\n<div class=\"hidden md:flex gap-8 items-center\">\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300\" href=\"#\">Home</a>\n<a class=\"font-label-lg text-label-lg text-primary dark:text-royal-gold font-bold border-b-2 border-royal-gold pb-1\" href=\"#\">About</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300\" href=\"#\">Services</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300\" href=\"#\">Portfolio</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300\" href=\"#\">Contact</a>\n</div>\n<div class=\"flex items-center gap-4\">\n<button class=\"material-symbols-outlined text-royal-gold cursor-pointer active:scale-95 transition-all\">light_mode</button>\n<button class=\"md:hidden material-symbols-outlined text-royal-gold\">menu</button>\n</div>\n</nav>\n<!-- Hero: Kinetic Typography -->\n<header class=\"relative min-h-[921px] flex flex-col items-center justify-center pt-32 px-margin-mobile md:px-margin-desktop text-center overflow-hidden\">\n<div class=\"absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_50%,rgba(212,175,55,0.05),transparent_70%)]\"></div>\n<div class=\"kinetic-text max-w-4xl\">\n<h1 class=\"font-display-lg text-headline-lg-mobile md:text-display-lg leading-tight mb-6\">\n<span style=\"animation-delay: 0.1s\">The</span>\n<span class=\"text-royal-gold\" style=\"animation-delay: 0.2s\">Smartest</span>\n<span style=\"animation-delay: 0.3s\">Minds</span>\n<span style=\"animation-delay: 0.4s\">in</span>\n<span class=\"italic\" style=\"animation-delay: 0.5s\">Digital</span>\n<span style=\"animation-delay: 0.6s\">Illumination.</span>\n</h1>\n</div>\n<p class=\"reveal font-body-lg text-body-lg text-tertiary max-w-2xl mx-auto mb-10\" style=\"transition-delay: 0.8s\">\n            Rayoba is not just an agency; it is a lineage of creative strategists dedicated to bringing sovereign clarity to modern brands.\n        </p>\n<div class=\"reveal flex gap-6\" style=\"transition-delay: 1s\">\n<button class=\"bg-royal-gold text-deep-violet font-label-lg px-8 py-4 rounded-xl royal-glow transition-all active:scale-95\">Our Story</button>\n<button class=\"border border-royal-gold text-royal-gold font-label-lg px-8 py-4 rounded-xl backdrop-blur-sm transition-all hover:bg-royal-gold/5\">The Lineage</button>\n</div>\n</header>\n<!-- Section 2: The Heritage -->\n<section class=\"py-24 md:py-32 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto\">\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 items-center\">\n<div class=\"reveal\">\n<span class=\"text-royal-gold font-label-lg uppercase tracking-widest mb-4 block\">The Genesis</span>\n<h2 class=\"font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-8\">Ray (Light) &amp; Oba (King)</h2>\n<div class=\"space-y-6 font-body-lg text-tertiary leading-relaxed\">\n<p>\n                        The name Rayoba is born from the convergence of two powerful archetypes: the <span class=\"text-on-background font-bold italic\">Ray</span> of illuminating insight and the <span class=\"text-on-background font-bold\">Oba</span>, the traditional Yoruba word for King.\n                    </p>\n<p>\n                        We believe that every brand deserves a seat at the table of authority. Our heritage is rooted in the philosophy that strategic digital growth is the modern crown of industry\342\200\224a synthesis of high-level creativity and calculated precision.\n                    </p>\n</div>\n<div class=\"mt-12 p-8 glass-card rounded-2xl flex gap-6\">\n<div class=\"h-16 w-16 rounded-full bg-secondary-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-secondary-container\" style=\"font-variation-settings: \'FILL\' 1;\">workspace_premium</span>\n</div>\n<div>\n<h4 class=\"font-headline-md text-headline-md mb-2\">Heritage of Excellence</h4>\n<p class=\"text-body-md text-tertiary\">Founded on principles of editorial luxury and technical dominance.</p>\n</div>\n</div>\n</div>\n<div class=\"reveal relative\">\n<div class=\"aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl relative group\">\n<img class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" data-alt=\"A cinematic, high-contrast portrait of a modern office space with a regal, golden aesthetic. The room is filled with soft natural light streaming through large windows, highlighting minimalist white furniture and a single, majestic velvet chair in deep violet. The mood is sophisticated, echoing a sense of royalty and contemporary digital leadership.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCAeTZyyo6j6O4MxABNdY7IekU4dW3nyMx7XxHsm4-ppFpGJuk6y_eVF3HLOVhxSZxViBqXD5sqj6yuVhD80BhDK-Mn6DWQUXcRzQZyE1IMOEWfvhoWGe8YS8kMhKLWp0NMb1IR-ng_nAL-vpW3hKOoo8isOeVrUtUTbecTAdizIKyAH36jmi_s1nS82sZekrHuTqM4N2iTp39INUX4HGj6ArcfO9vGoydK7nBVLJxhhxE7VVtm4FG-3sYf9Yah82Bn-Sn3ihQM0PI\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-midnight-royal/60 to-transparent\"></div>\n<div class=\"absolute bottom-8 left-8 right-8\">\n<p class=\"text-gilded-ivory font-display-md text-headline-md leading-tight\">\"To Lead is to Illuminate.\"</p>\n</div>\n</div>\n<!-- 3D Element Shadow -->\n<div class=\"absolute -bottom-10 -right-10 h-64 w-64 bg-royal-gold/10 blur-[80px] rounded-full -z-10\"></div>\n</div>\n</div>\n</section>\n<!-- Section 3: The Majesty Method (Vertical Stepper) -->\n<section class=\"bg-midnight-royal py-32 px-margin-mobile md:px-margin-desktop text-gilded-ivory overflow-hidden relative\">\n<div class=\"max-w-container-max mx-auto relative z-10\">\n<div class=\"text-center mb-24 reveal\">\n<h2 class=\"font-headline-lg text-headline-lg-mobile md:text-display-md text-royal-gold mb-6\">The Majesty Method</h2>\n<p class=\"text-tertiary-fixed-dim max-w-xl mx-auto\">Our proven progression to brand sovereignty.</p>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-12 relative\">\n<!-- Connective Line (Desktop) -->\n<div class=\"hidden md:block absolute top-12 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-royal-gold/30 to-transparent\"></div>\n<!-- Step 1 -->\n<div class=\"reveal group\" style=\"transition-delay: 0.2s\">\n<div class=\"relative mb-12 flex justify-center\">\n<div class=\"h-24 w-24 rounded-full bg-midnight-royal border-4 border-royal-gold flex items-center justify-center text-royal-gold font-display-md text-headline-lg z-10 transition-transform group-hover:scale-110\">01</div>\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-32 w-32 bg-royal-gold/10 blur-xl rounded-full\"></div>\n</div>\n<div class=\"text-center\">\n<h3 class=\"font-headline-md text-headline-md mb-4\">Immersion</h3>\n<p class=\"text-tertiary-fixed-dim leading-relaxed\">Deep dive into your brand\'s DNA, uncovering hidden strengths and market voids through meticulous strategic audit.</p>\n</div>\n</div>\n<!-- Step 2 -->\n<div class=\"reveal group\" style=\"transition-delay: 0.4s\">\n<div class=\"relative mb-12 flex justify-center\">\n<div class=\"h-24 w-24 rounded-full bg-midnight-royal border-4 border-royal-gold flex items-center justify-center text-royal-gold font-display-md text-headline-lg z-10 transition-transform group-hover:scale-110\">02</div>\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-32 w-32 bg-royal-gold/10 blur-xl rounded-full\"></div>\n</div>\n<div class=\"text-center\">\n<h3 class=\"font-headline-md text-headline-md mb-4\">Manifestation</h3>\n<p class=\"text-tertiary-fixed-dim leading-relaxed\">Artisanal execution of creative assets. From cinematic video to architectural web design, we bring the vision to tangible life.</p>\n</div>\n</div>\n<!-- Step 3 -->\n<div class=\"reveal group\" style=\"transition-delay: 0.6s\">\n<div class=\"relative mb-12 flex justify-center\">\n<div class=\"h-24 w-24 rounded-full bg-midnight-royal border-4 border-royal-gold flex items-center justify-center text-royal-gold font-display-md text-headline-lg z-10 transition-transform group-hover:scale-110\">03</div>\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-32 w-32 bg-royal-gold/10 blur-xl rounded-full\"></div>\n</div>\n<div class=\"text-center\">\n<h3 class=\"font-headline-md text-headline-md mb-4\">Ascension</h3>\n<p class=\"text-tertiary-fixed-dim leading-relaxed\">Scaling the sovereign brand. Data-driven optimization and cross-platform growth strategies to ensure long-term dominance.</p>\n</div>\n</div>\n</div>\n</div>\n<!-- Decorative Text -->\n<div class=\"absolute -bottom-10 left-1/2 -translate-x-1/2 opacity-5 whitespace-nowrap\">\n<span class=\"font-display-lg text-[180px] uppercase tracking-tighter\">EXCELLENCE</span>\n</div>\n</section>\n<!-- Section 4: Team/Values Bento Grid -->\n<section class=\"py-32 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-gutter\">\n<div class=\"md:col-span-8 reveal\">\n<div class=\"bg-surface-container p-12 rounded-3xl h-full flex flex-col justify-end min-h-[400px] relative overflow-hidden group\">\n<img class=\"absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-30 transition-opacity\" data-alt=\"A high-end editorial shot of a creative team collaborating in a bright, modern studio. The space features large windows, minimal white desks, and golden accents. The team members are diverse and dressed in sophisticated business-casual attire, engaged in a vibrant brainstorming session around a large wooden table. The lighting is crisp and optimistic, emphasizing a premium professional atmosphere.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDJO8t_wCArPGFBWHQ-zzIXb07eqvn7WuXa9ng_i9cycq0AyKlZ1W-vrWp0KDy9LGmcmdfdYAcvU5koNsRNxOrJtrbic_HPYsLolu2dZeymiKEiu_3-thOXUYdgF4pHuJ8OVVcREz8AUzsEcvhzQ8HmogCqdx79jA_cvrmfFJws-Hk6V-YBZlcvDJuRmSM16oY24zdtCCH0ni3xZ9KZGRC2AN6-zYMRMR8hse6Ryao0XW3j0J7jZdzSG8ywzDtJXIeCMYPyhQQH1sY\"/>\n<div class=\"relative z-10\">\n<h3 class=\"font-headline-lg text-headline-lg mb-4\">Creativity Meets Strategy</h3>\n<p class=\"text-body-lg text-tertiary max-w-xl\">We don\'t just make things look beautiful. We make them perform at a level that disrupts the status quo.</p>\n</div>\n</div>\n</div>\n<div class=\"md:col-span-4 reveal\" style=\"transition-delay: 0.2s\">\n<div class=\"bg-secondary p-12 rounded-3xl h-full text-gilded-ivory\">\n<span class=\"material-symbols-outlined text-[48px] mb-8\" style=\"font-variation-settings: \'FILL\' 1;\">groups</span>\n<h3 class=\"font-headline-md text-headline-md mb-4\">Client-Centric</h3>\n<p class=\"text-body-md opacity-80\">You are the sovereign; we are your royal council. Your goals are the blueprint of our success.</p>\n</div>\n</div>\n<div class=\"md:col-span-4 reveal\" style=\"transition-delay: 0.3s\">\n<div class=\"border border-glass-stroke p-12 rounded-3xl h-full hover:bg-surface-container-low transition-colors\">\n<h3 class=\"font-headline-md text-headline-md mb-4\">Precision Mastery</h3>\n<p class=\"text-body-md text-tertiary\">Meticulous attention to detail in every frame, pixel, and line of code.</p>\n</div>\n</div>\n<div class=\"md:col-span-8 reveal\" style=\"transition-delay: 0.4s\">\n<div class=\"bg-royal-gold p-12 rounded-3xl h-full flex flex-col md:flex-row items-center gap-8\">\n<div class=\"text-deep-violet\">\n<h3 class=\"font-headline-lg text-headline-lg mb-4\">Join the Royal Lineage</h3>\n<p class=\"font-body-lg\">Partnering with the world\'s most ambitious visionaries to define the next era of digital excellence.</p>\n</div>\n<div class=\"shrink-0\">\n<div class=\"h-24 w-24 rounded-full bg-deep-violet flex items-center justify-center text-royal-gold animate-pulse cursor-pointer\">\n<span class=\"material-symbols-outlined text-[40px]\">arrow_forward</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Section 5: CTA Editorial -->\n<section class=\"pb-32 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto reveal\">\n<div class=\"relative rounded-3xl overflow-hidden bg-midnight-royal p-12 md:p-24 text-center\">\n<div class=\"absolute inset-0 opacity-20 pointer-events-none\">\n<div class=\"absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_20%_30%,#D4AF37_0%,transparent_50%)]\"></div>\n</div>\n<span class=\"text-royal-gold font-label-lg tracking-[0.3em] uppercase mb-8 block\">Project Inquiry</span>\n<h2 class=\"font-display-lg text-headline-lg-mobile md:text-display-lg text-gilded-ivory mb-12\">Manifest Your Majesty.</h2>\n<p class=\"text-tertiary-fixed-dim text-body-lg max-w-2xl mx-auto mb-12\">Are you ready to claim your position of authority in the digital realm? Let us illuminate the path forward.</p>\n<form class=\"max-w-xl mx-auto flex flex-col md:flex-row gap-4\">\n<input class=\"flex-grow bg-white/5 border border-white/20 rounded-xl px-6 py-4 text-gilded-ivory focus:outline-none focus:border-royal-gold transition-colors\" placeholder=\"Enter your royal email\" type=\"email\"/>\n<button class=\"bg-royal-gold text-deep-violet font-label-lg px-10 py-4 rounded-xl font-bold whitespace-nowrap royal-glow transition-all active:scale-95\">Summon Us</button>\n</form>\n</div>\n</section>\n<!-- Shared Component: Footer -->\n<footer class=\"w-full relative mt-margin-desktop bg-midnight-royal border-t border-glass-stroke\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-gutter px-margin-desktop py-20 max-w-container-max mx-auto text-gilded-ivory\">\n<div class=\"md:col-span-5\">\n<span class=\"font-display-lg text-display-lg text-royal-gold mb-6 block\">Rayoba.</span>\n<p class=\"text-tertiary-fixed-dim text-body-md max-w-sm mb-8\">\n                    Defining the intersection of technical dominance and editorial luxury for the modern era.\n                </p>\n<div class=\"flex gap-4\">\n<a class=\"material-symbols-outlined text-royal-gold hover:opacity-80 transition-opacity\" href=\"#\">language</a>\n<a class=\"material-symbols-outlined text-royal-gold hover:opacity-80 transition-opacity\" href=\"#\">alternate_email</a>\n<a class=\"material-symbols-outlined text-royal-gold hover:opacity-80 transition-opacity\" href=\"#\">share</a>\n</div>\n</div>\n<div class=\"md:col-span-2\">\n<h5 class=\"text-royal-gold font-label-lg mb-6\">Explore</h5>\n<ul class=\"space-y-4\">\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Work</a></li>\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Capabilities</a></li>\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Insights</a></li>\n</ul>\n</div>\n<div class=\"md:col-span-2\">\n<h5 class=\"text-royal-gold font-label-lg mb-6\">Legal</h5>\n<ul class=\"space-y-4\">\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Privacy</a></li>\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Terms</a></li>\n</ul>\n</div>\n<div class=\"md:col-span-3\">\n<h5 class=\"text-royal-gold font-label-lg mb-6\">Contact</h5>\n<p class=\"text-tertiary-fixed-dim text-body-md mb-2\">studio@rayoba.media</p>\n<p class=\"text-tertiary-fixed-dim text-body-md\">Lagos | London | Remote</p>\n</div>\n<div class=\"md:col-span-12 mt-12 pt-12 border-t border-white/5 flex justify-between items-center text-sm opacity-60\">\n<p>\302\251 2024 Rayoba Media. Editorial Excellence.</p>\n<div class=\"flex gap-6\">\n<a href=\"#\">Instagram</a>\n<a href=\"#\">LinkedIn</a>\n<a href=\"#\">Twitter</a>\n<a class=\"text-royal-gold underline\" href=\"#\">Inquiry</a>\n</div>\n</div>\n</div>\n</footer>\n<script>\n        // Simple Intersection Observer for scroll revelations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: \'0px 0px -50px 0px\'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add(\'active\');\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll(\'.reveal\').forEach(el => observer.observe(el));\n\n        // Smooth scroll effect\n        document.querySelectorAll(\'a[href^=\"#\"]\').forEach(anchor => {\n            anchor.addEventListener(\'click\', function (e) {\n                e.preventDefault();\n                document.querySelector(this.getAttribute(\'href\')).scrollIntoView({\n                    behavior: \'smooth\'\n                });\n            });\n        });\n\n        // Micro-interaction for 3D card tilt effect (subtle)\n        document.querySelectorAll(\'.glass-card\').forEach(card => {\n            card.addEventListener(\'mousemove\', (e) => {\n                const rect = card.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                const centerX = rect.width / 2;\n                const centerY = rect.height / 2;\n                const rotateX = (y - centerY) / 20;\n                const rotateY = (centerX - x) / 20;\n                \n                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n            });\n\n            card.addEventListener(\'mouseleave\', () => {\n                card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;\n            });\n        });\n    </script>\n</body></html>"
    items {
      text: "next page\n\n<!DOCTYPE html>\n\n<html class=\"scroll-smooth\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>About | Rayoba Media - The Royal Lineage</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">tailwind.config = {darkMode: \"class\", theme: {extend: {colors: {error: \"#ba1a1a\", \"on-secondary-container\": \"#4f3687\", background: \"#fcf8f9\", tertiary: \"#5d5e5f\", \"secondary-container\": \"#c0a5fe\", \"surface-bright\": \"#fcf8f9\", \"gilded-ivory\": \"#FDFBF7\", \"tertiary-container\": \"#b2b3b3\", outline: \"#7f7663\", \"surface-container\": \"#f0edee\", \"surface-variant\": \"#e5e2e3\", \"tertiary-fixed\": \"#e2e2e2\", \"inverse-primary\": \"#e9c349\", \"on-secondary-fixed-variant\": \"#503788\", \"on-tertiary-fixed-variant\": \"#454747\", \"royal-gold\": \"#D4AF37\", \"surface-container-low\": \"#f6f3f4\", \"tertiary-fixed-dim\": \"#c6c6c6\", \"on-tertiary\": \"#ffffff\", \"on-background\": \"#1c1b1c\", \"on-tertiary-container\": \"#444546\", primary: \"#735c00\", \"outline-variant\": \"#d0c5af\", \"midnight-royal\": \"#0A0A0B\", \"inverse-on-surface\": \"#f3f0f1\", \"on-primary-fixed-variant\": \"#574500\", \"glass-stroke\": \"rgba(212, 175, 55, 0.2)\", \"deep-violet\": \"#2E1065\", \"surface-container-lowest\": \"#ffffff\", \"surface-tint\": \"#735c00\", \"on-error-container\": \"#93000a\", \"surface-dim\": \"#dcd9da\", \"surface-container-high\": \"#ebe7e8\", secondary: \"#6950a2\", \"secondary-fixed-dim\": \"#d1bcff\", surface: \"#fcf8f9\", \"on-primary-container\": \"#554300\", \"secondary-fixed\": \"#eaddff\", \"on-secondary\": \"#ffffff\", \"on-tertiary-fixed\": \"#1a1c1c\", \"primary-container\": \"#d4af37\", \"error-container\": \"#ffdad6\", \"on-primary-fixed\": \"#241a00\", \"inverse-surface\": \"#313031\", \"on-surface-variant\": \"#4d4635\", \"on-secondary-fixed\": \"#24005b\", \"primary-fixed\": \"#ffe088\", \"on-surface\": \"#1c1b1c\", \"on-primary\": \"#ffffff\", \"on-error\": \"#ffffff\", \"surface-container-highest\": \"#e5e2e3\", \"primary-fixed-dim\": \"#e9c349\"}, borderRadius: {DEFAULT: \"0.25rem\", lg: \"0.5rem\", xl: \"0.75rem\", full: \"9999px\"}, spacing: {gutter: \"24px\", \"container-max\": \"1280px\", \"margin-mobile\": \"20px\", \"margin-desktop\": \"80px\", unit: \"4px\"}, fontFamily: {\"display-md\": [\"Playfair Display\"], \"body-lg\": [\"Plus Jakarta Sans\"], \"label-lg\": [\"Plus Jakarta Sans\"], \"headline-lg\": [\"Playfair Display\"], \"display-lg\": [\"Playfair Display\"], \"headline-md\": [\"Playfair Display\"], \"body-md\": [\"Plus Jakarta Sans\"], \"headline-lg-mobile\": [\"Playfair Display\"], \"label-sm\": [\"Plus Jakarta Sans\"], headline: [\"Playfair Display\"], display: [\"Playfair Display\"], body: [\"Plus Jakarta Sans\"], label: [\"Plus Jakarta Sans\"]}, fontSize: {\"display-md\": [\"56px\", {lineHeight: \"64px\", letterSpacing: \"-0.01em\", fontWeight: \"700\"}], \"body-lg\": [\"18px\", {lineHeight: \"28px\", fontWeight: \"400\"}], \"label-lg\": [\"14px\", {lineHeight: \"20px\", letterSpacing: \"0.05em\", fontWeight: \"600\"}], \"headline-lg\": [\"40px\", {lineHeight: \"48px\", fontWeight: \"600\"}], \"display-lg\": [\"72px\", {lineHeight: \"80px\", letterSpacing: \"-0.02em\", fontWeight: \"700\"}], \"headline-md\": [\"24px\", {lineHeight: \"32px\", fontWeight: \"600\"}], \"body-md\": [\"16px\", {lineHeight: \"24px\", fontWeight: \"400\"}], \"headline-lg-mobile\": [\"32px\", {lineHeight: \"40px\", fontWeight: \"600\"}], \"label-sm\": [\"12px\", {lineHeight: \"16px\", letterSpacing: \"0.02em\", fontWeight: \"500\"}]}}}};</script>\n<style>.noise-overlay {\n    pointer-events: none;\n    position: fixed;\n    inset: 0;\n    z-index: 9999;\n    opacity: 0.03;\n    background-image: url(https://lh3.googleusercontent.com/aida-public/AB6AXuDIdmOAfvKNUnDIvOxcSRC_fYnX9RDL9Z4JK5xox9GjqR5QGvdJu7thb-c0ZLh9zm0mc4Uj8AzWRYflxePa6F1aRNTa2SQp924zTMKBb6NXmdNJ9L8Iqtv5Fkr7b8fIDT0q4d892L6SKWuFjJZheEgNC7nBFAYwl9G9s5kihuDue3nt7KDdWMfJf8xber4UWYfn0SDmczGfF_r6iAzVpVupwnSV5LKPpUTzV_IdBLAN8kv3gzecsPb2v0H5K327GTPrqumGvBU52as)\n    }\n.reveal {\n    opacity: 0;\n    transform: translatey(30px);\n    transition: all 0.8s ease-out\n    }\n.reveal.active {\n    opacity: 1;\n    transform: translatey(0)\n    }\n.glass-card {\n    background: rgba(253, 251, 247, 0.4);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(212, 175, 55, 0.2);\n    box-shadow: 0 10px 30px -10px rgba(46, 16, 101, 0.05)\n    }\n.kinetic-text span {\n    display: inline-block;\n    animation: text-reveal 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;\n    opacity: 0;\n    transform: translatey(100%)\n    }\n@keyframes text-reveal {\n    to {\n        opacity: 1;\n        transform: translateY(0);\n        }\n    }\n.royal-glow:hover {\n    box-shadow: 0 0 20px rgba(212, 175, 55, 0.3)\n    }</style>\n</head>\n<body class=\"bg-background text-on-background font-body-md overflow-x-hidden\">\n<div class=\"noise-overlay\"></div>\n<!-- Shared Component: TopNavBar -->\n<nav class=\"fixed top-4 left-1/2 -translate-x-1/2 w-[calc(100%-48px)] max-w-container-max rounded-xl border border-glass-stroke bg-surface/80 dark:bg-midnight-royal/80 backdrop-blur-xl shadow-2xl shadow-secondary/10 flex justify-between items-center px-gutter py-4 z-50\">\n<div class=\"flex items-center gap-2\">\n<img alt=\"Rayoba Logo\" class=\"h-8 md:h-10 hover:scale-105 transition-transform duration-300 cursor-pointer\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuACnOZOoW6wmJpLQmCWkN3BBRPXLkOm0qm0XlxCox0gUZpexlFDizTA1Z4OceMxj7UfLF98cSLs94cnQ3kgdc3ADrREcOzrZ8NucGUIzRgcGUlPOhdea4N8eydmmiNlYfyzRwoV1nOpIiz55fIAb3gkj0Jhb-oBNlaWSduyD52MWbscqTlbH0qEawlBHV7Jj6vBeeSRf1rqwPtFsG7APAkGjX-yYyyWYcAVtYX98GhfHia8t49STrpcgxGhF21hAVAkj1D_muZUHn8\"/>\n<span class=\"font-display-md text-display-md tracking-tighter text-royal-gold hidden md:block\">Rayoba Media</span>\n</div>\n<div class=\"hidden md:flex gap-8 items-center\">\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300\" href=\"#\">Home</a>\n<a class=\"font-label-lg text-label-lg text-primary dark:text-royal-gold font-bold border-b-2 border-royal-gold pb-1\" href=\"#\">About</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300\" href=\"#\">Services</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300\" href=\"#\">Portfolio</a>\n<a class=\"font-label-lg text-label-lg text-on-surface dark:text-gilded-ivory hover:text-royal-gold transition-colors duration-300\" href=\"#\">Contact</a>\n</div>\n<div class=\"flex items-center gap-4\">\n<button class=\"material-symbols-outlined text-royal-gold cursor-pointer active:scale-95 transition-all\">light_mode</button>\n<button class=\"md:hidden material-symbols-outlined text-royal-gold\">menu</button>\n</div>\n</nav>\n<!-- Hero: Kinetic Typography -->\n<header class=\"relative min-h-[921px] flex flex-col items-center justify-center pt-32 px-margin-mobile md:px-margin-desktop text-center overflow-hidden\">\n<div class=\"absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_50%,rgba(212,175,55,0.05),transparent_70%)]\"></div>\n<div class=\"kinetic-text max-w-4xl\">\n<h1 class=\"font-display-lg text-headline-lg-mobile md:text-display-lg leading-tight mb-6\">\n<span style=\"animation-delay: 0.1s\">The</span>\n<span class=\"text-royal-gold\" style=\"animation-delay: 0.2s\">Smartest</span>\n<span style=\"animation-delay: 0.3s\">Minds</span>\n<span style=\"animation-delay: 0.4s\">in</span>\n<span class=\"italic\" style=\"animation-delay: 0.5s\">Digital</span>\n<span style=\"animation-delay: 0.6s\">Illumination.</span>\n</h1>\n</div>\n<p class=\"reveal font-body-lg text-body-lg text-tertiary max-w-2xl mx-auto mb-10\" style=\"transition-delay: 0.8s\">\n            Rayoba is not just an agency; it is a lineage of creative strategists dedicated to bringing sovereign clarity to modern brands.\n        </p>\n<div class=\"reveal flex gap-6\" style=\"transition-delay: 1s\">\n<button class=\"bg-royal-gold text-deep-violet font-label-lg px-8 py-4 rounded-xl royal-glow transition-all active:scale-95\">Our Story</button>\n<button class=\"border border-royal-gold text-royal-gold font-label-lg px-8 py-4 rounded-xl backdrop-blur-sm transition-all hover:bg-royal-gold/5\">The Lineage</button>\n</div>\n</header>\n<!-- Section 2: The Heritage -->\n<section class=\"py-24 md:py-32 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto\">\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 items-center\">\n<div class=\"reveal\">\n<span class=\"text-royal-gold font-label-lg uppercase tracking-widest mb-4 block\">The Genesis</span>\n<h2 class=\"font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-8\">Ray (Light) &amp; Oba (King)</h2>\n<div class=\"space-y-6 font-body-lg text-tertiary leading-relaxed\">\n<p>\n                        The name Rayoba is born from the convergence of two powerful archetypes: the <span class=\"text-on-background font-bold italic\">Ray</span> of illuminating insight and the <span class=\"text-on-background font-bold\">Oba</span>, the traditional Yoruba word for King.\n                    </p>\n<p>\n                        We believe that every brand deserves a seat at the table of authority. Our heritage is rooted in the philosophy that strategic digital growth is the modern crown of industry\342\200\224a synthesis of high-level creativity and calculated precision.\n                    </p>\n</div>\n<div class=\"mt-12 p-8 glass-card rounded-2xl flex gap-6\">\n<div class=\"h-16 w-16 rounded-full bg-secondary-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-secondary-container\" style=\"font-variation-settings: \'FILL\' 1;\">workspace_premium</span>\n</div>\n<div>\n<h4 class=\"font-headline-md text-headline-md mb-2\">Heritage of Excellence</h4>\n<p class=\"text-body-md text-tertiary\">Founded on principles of editorial luxury and technical dominance.</p>\n</div>\n</div>\n</div>\n<div class=\"reveal relative\">\n<div class=\"aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl relative group\">\n<img class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" data-alt=\"A cinematic, high-contrast portrait of a modern office space with a regal, golden aesthetic. The room is filled with soft natural light streaming through large windows, highlighting minimalist white furniture and a single, majestic velvet chair in deep violet. The mood is sophisticated, echoing a sense of royalty and contemporary digital leadership.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCAeTZyyo6j6O4MxABNdY7IekU4dW3nyMx7XxHsm4-ppFpGJuk6y_eVF3HLOVhxSZxViBqXD5sqj6yuVhD80BhDK-Mn6DWQUXcRzQZyE1IMOEWfvhoWGe8YS8kMhKLWp0NMb1IR-ng_nAL-vpW3hKOoo8isOeVrUtUTbecTAdizIKyAH36jmi_s1nS82sZekrHuTqM4N2iTp39INUX4HGj6ArcfO9vGoydK7nBVLJxhhxE7VVtm4FG-3sYf9Yah82Bn-Sn3ihQM0PI\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-midnight-royal/60 to-transparent\"></div>\n<div class=\"absolute bottom-8 left-8 right-8\">\n<p class=\"text-gilded-ivory font-display-md text-headline-md leading-tight\">\"To Lead is to Illuminate.\"</p>\n</div>\n</div>\n<!-- 3D Element Shadow -->\n<div class=\"absolute -bottom-10 -right-10 h-64 w-64 bg-royal-gold/10 blur-[80px] rounded-full -z-10\"></div>\n</div>\n</div>\n</section>\n<!-- Section 3: The Majesty Method (Vertical Stepper) -->\n<section class=\"bg-midnight-royal py-32 px-margin-mobile md:px-margin-desktop text-gilded-ivory overflow-hidden relative\">\n<div class=\"max-w-container-max mx-auto relative z-10\">\n<div class=\"text-center mb-24 reveal\">\n<h2 class=\"font-headline-lg text-headline-lg-mobile md:text-display-md text-royal-gold mb-6\">The Majesty Method</h2>\n<p class=\"text-tertiary-fixed-dim max-w-xl mx-auto\">Our proven progression to brand sovereignty.</p>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-12 relative\">\n<!-- Connective Line (Desktop) -->\n<div class=\"hidden md:block absolute top-12 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-royal-gold/30 to-transparent\"></div>\n<!-- Step 1 -->\n<div class=\"reveal group\" style=\"transition-delay: 0.2s\">\n<div class=\"relative mb-12 flex justify-center\">\n<div class=\"h-24 w-24 rounded-full bg-midnight-royal border-4 border-royal-gold flex items-center justify-center text-royal-gold font-display-md text-headline-lg z-10 transition-transform group-hover:scale-110\">01</div>\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-32 w-32 bg-royal-gold/10 blur-xl rounded-full\"></div>\n</div>\n<div class=\"text-center\">\n<h3 class=\"font-headline-md text-headline-md mb-4\">Immersion</h3>\n<p class=\"text-tertiary-fixed-dim leading-relaxed\">Deep dive into your brand\'s DNA, uncovering hidden strengths and market voids through meticulous strategic audit.</p>\n</div>\n</div>\n<!-- Step 2 -->\n<div class=\"reveal group\" style=\"transition-delay: 0.4s\">\n<div class=\"relative mb-12 flex justify-center\">\n<div class=\"h-24 w-24 rounded-full bg-midnight-royal border-4 border-royal-gold flex items-center justify-center text-royal-gold font-display-md text-headline-lg z-10 transition-transform group-hover:scale-110\">02</div>\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-32 w-32 bg-royal-gold/10 blur-xl rounded-full\"></div>\n</div>\n<div class=\"text-center\">\n<h3 class=\"font-headline-md text-headline-md mb-4\">Manifestation</h3>\n<p class=\"text-tertiary-fixed-dim leading-relaxed\">Artisanal execution of creative assets. From cinematic video to architectural web design, we bring the vision to tangible life.</p>\n</div>\n</div>\n<!-- Step 3 -->\n<div class=\"reveal group\" style=\"transition-delay: 0.6s\">\n<div class=\"relative mb-12 flex justify-center\">\n<div class=\"h-24 w-24 rounded-full bg-midnight-royal border-4 border-royal-gold flex items-center justify-center text-royal-gold font-display-md text-headline-lg z-10 transition-transform group-hover:scale-110\">03</div>\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-32 w-32 bg-royal-gold/10 blur-xl rounded-full\"></div>\n</div>\n<div class=\"text-center\">\n<h3 class=\"font-headline-md text-headline-md mb-4\">Ascension</h3>\n<p class=\"text-tertiary-fixed-dim leading-relaxed\">Scaling the sovereign brand. Data-driven optimization and cross-platform growth strategies to ensure long-term dominance.</p>\n</div>\n</div>\n</div>\n</div>\n<!-- Decorative Text -->\n<div class=\"absolute -bottom-10 left-1/2 -translate-x-1/2 opacity-5 whitespace-nowrap\">\n<span class=\"font-display-lg text-[180px] uppercase tracking-tighter\">EXCELLENCE</span>\n</div>\n</section>\n<!-- Section 4: Team/Values Bento Grid -->\n<section class=\"py-32 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-gutter\">\n<div class=\"md:col-span-8 reveal\">\n<div class=\"bg-surface-container p-12 rounded-3xl h-full flex flex-col justify-end min-h-[400px] relative overflow-hidden group\">\n<img class=\"absolute inset-0 w-full h-full object-cover opacity-20 group-hover:opacity-30 transition-opacity\" data-alt=\"A high-end editorial shot of a creative team collaborating in a bright, modern studio. The space features large windows, minimal white desks, and golden accents. The team members are diverse and dressed in sophisticated business-casual attire, engaged in a vibrant brainstorming session around a large wooden table. The lighting is crisp and optimistic, emphasizing a premium professional atmosphere.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDJO8t_wCArPGFBWHQ-zzIXb07eqvn7WuXa9ng_i9cycq0AyKlZ1W-vrWp0KDy9LGmcmdfdYAcvU5koNsRNxOrJtrbic_HPYsLolu2dZeymiKEiu_3-thOXUYdgF4pHuJ8OVVcREz8AUzsEcvhzQ8HmogCqdx79jA_cvrmfFJws-Hk6V-YBZlcvDJuRmSM16oY24zdtCCH0ni3xZ9KZGRC2AN6-zYMRMR8hse6Ryao0XW3j0J7jZdzSG8ywzDtJXIeCMYPyhQQH1sY\"/>\n<div class=\"relative z-10\">\n<h3 class=\"font-headline-lg text-headline-lg mb-4\">Creativity Meets Strategy</h3>\n<p class=\"text-body-lg text-tertiary max-w-xl\">We don\'t just make things look beautiful. We make them perform at a level that disrupts the status quo.</p>\n</div>\n</div>\n</div>\n<div class=\"md:col-span-4 reveal\" style=\"transition-delay: 0.2s\">\n<div class=\"bg-secondary p-12 rounded-3xl h-full text-gilded-ivory\">\n<span class=\"material-symbols-outlined text-[48px] mb-8\" style=\"font-variation-settings: \'FILL\' 1;\">groups</span>\n<h3 class=\"font-headline-md text-headline-md mb-4\">Client-Centric</h3>\n<p class=\"text-body-md opacity-80\">You are the sovereign; we are your royal council. Your goals are the blueprint of our success.</p>\n</div>\n</div>\n<div class=\"md:col-span-4 reveal\" style=\"transition-delay: 0.3s\">\n<div class=\"border border-glass-stroke p-12 rounded-3xl h-full hover:bg-surface-container-low transition-colors\">\n<h3 class=\"font-headline-md text-headline-md mb-4\">Precision Mastery</h3>\n<p class=\"text-body-md text-tertiary\">Meticulous attention to detail in every frame, pixel, and line of code.</p>\n</div>\n</div>\n<div class=\"md:col-span-8 reveal\" style=\"transition-delay: 0.4s\">\n<div class=\"bg-royal-gold p-12 rounded-3xl h-full flex flex-col md:flex-row items-center gap-8\">\n<div class=\"text-deep-violet\">\n<h3 class=\"font-headline-lg text-headline-lg mb-4\">Join the Royal Lineage</h3>\n<p class=\"font-body-lg\">Partnering with the world\'s most ambitious visionaries to define the next era of digital excellence.</p>\n</div>\n<div class=\"shrink-0\">\n<div class=\"h-24 w-24 rounded-full bg-deep-violet flex items-center justify-center text-royal-gold animate-pulse cursor-pointer\">\n<span class=\"material-symbols-outlined text-[40px]\">arrow_forward</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Section 5: CTA Editorial -->\n<section class=\"pb-32 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto reveal\">\n<div class=\"relative rounded-3xl overflow-hidden bg-midnight-royal p-12 md:p-24 text-center\">\n<div class=\"absolute inset-0 opacity-20 pointer-events-none\">\n<div class=\"absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_20%_30%,#D4AF37_0%,transparent_50%)]\"></div>\n</div>\n<span class=\"text-royal-gold font-label-lg tracking-[0.3em] uppercase mb-8 block\">Project Inquiry</span>\n<h2 class=\"font-display-lg text-headline-lg-mobile md:text-display-lg text-gilded-ivory mb-12\">Manifest Your Majesty.</h2>\n<p class=\"text-tertiary-fixed-dim text-body-lg max-w-2xl mx-auto mb-12\">Are you ready to claim your position of authority in the digital realm? Let us illuminate the path forward.</p>\n<form class=\"max-w-xl mx-auto flex flex-col md:flex-row gap-4\">\n<input class=\"flex-grow bg-white/5 border border-white/20 rounded-xl px-6 py-4 text-gilded-ivory focus:outline-none focus:border-royal-gold transition-colors\" placeholder=\"Enter your royal email\" type=\"email\"/>\n<button class=\"bg-royal-gold text-deep-violet font-label-lg px-10 py-4 rounded-xl font-bold whitespace-nowrap royal-glow transition-all active:scale-95\">Summon Us</button>\n</form>\n</div>\n</section>\n<!-- Shared Component: Footer -->\n<footer class=\"w-full relative mt-margin-desktop bg-midnight-royal border-t border-glass-stroke\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-gutter px-margin-desktop py-20 max-w-container-max mx-auto text-gilded-ivory\">\n<div class=\"md:col-span-5\">\n<span class=\"font-display-lg text-display-lg text-royal-gold mb-6 block\">Rayoba.</span>\n<p class=\"text-tertiary-fixed-dim text-body-md max-w-sm mb-8\">\n                    Defining the intersection of technical dominance and editorial luxury for the modern era.\n                </p>\n<div class=\"flex gap-4\">\n<a class=\"material-symbols-outlined text-royal-gold hover:opacity-80 transition-opacity\" href=\"#\">language</a>\n<a class=\"material-symbols-outlined text-royal-gold hover:opacity-80 transition-opacity\" href=\"#\">alternate_email</a>\n<a class=\"material-symbols-outlined text-royal-gold hover:opacity-80 transition-opacity\" href=\"#\">share</a>\n</div>\n</div>\n<div class=\"md:col-span-2\">\n<h5 class=\"text-royal-gold font-label-lg mb-6\">Explore</h5>\n<ul class=\"space-y-4\">\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Work</a></li>\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Capabilities</a></li>\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Insights</a></li>\n</ul>\n</div>\n<div class=\"md:col-span-2\">\n<h5 class=\"text-royal-gold font-label-lg mb-6\">Legal</h5>\n<ul class=\"space-y-4\">\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Privacy</a></li>\n<li><a class=\"text-tertiary-fixed-dim hover:text-royal-gold transition-colors\" href=\"#\">Terms</a></li>\n</ul>\n</div>\n<div class=\"md:col-span-3\">\n<h5 class=\"text-royal-gold font-label-lg mb-6\">Contact</h5>\n<p class=\"text-tertiary-fixed-dim text-body-md mb-2\">studio@rayoba.media</p>\n<p class=\"text-tertiary-fixed-dim text-body-md\">Lagos | London | Remote</p>\n</div>\n<div class=\"md:col-span-12 mt-12 pt-12 border-t border-white/5 flex justify-between items-center text-sm opacity-60\">\n<p>\302\251 2024 Rayoba Media. Editorial Excellence.</p>\n<div class=\"flex gap-6\">\n<a href=\"#\">Instagram</a>\n<a href=\"#\">LinkedIn</a>\n<a href=\"#\">Twitter</a>\n<a class=\"text-royal-gold underline\" href=\"#\">Inquiry</a>\n</div>\n</div>\n</div>\n</footer>\n<script>\n        // Simple Intersection Observer for scroll revelations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: \'0px 0px -50px 0px\'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add(\'active\');\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll(\'.reveal\').forEach(el => observer.observe(el));\n\n        // Smooth scroll effect\n        document.querySelectorAll(\'a[href^=\"#\"]\').forEach(anchor => {\n            anchor.addEventListener(\'click\', function (e) {\n                e.preventDefault();\n                document.querySelector(this.getAttribute(\'href\')).scrollIntoView({\n                    behavior: \'smooth\'\n                });\n            });\n        });\n\n        // Micro-interaction for 3D card tilt effect (subtle)\n        document.querySelectorAll(\'.glass-card\').forEach(card => {\n            card.addEventListener(\'mousemove\', (e) => {\n                const rect = card.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                const centerX = rect.width / 2;\n                const centerY = rect.height / 2;\n                const rotateX = (y - centerY) / 20;\n                const rotateY = (centerX - x) / 20;\n                \n                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n            });\n\n            card.addEventListener(\'mouseleave\', () => {\n                card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;\n            });\n        });\n    </script>\n</body></html>"
    }
  }
}
