  file_change {
    absolute_path_uri: "file:///src/components/PortfolioPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { PROJECTS } from \'../data\';\nimport { Project } from \'../types\';\nimport { Filter, X, ArrowUpRight, TrendingUp, Calendar, Globe, Award, Target, Landmark, CheckCircle } from \'lucide-react\';\n\nexport default function PortfolioPage() {\n  const [activeCategory, setActiveCategory] = useState<string>(\'All\');\n  const [selectedProject, setSelectedProject] = useState<Project | null>(null);\n\n  const categories = [\'All\', \'Branding\', \'Digital Creative\', \'Editorial\'];\n\n  const filteredProjects = activeCategory === \'All\'\n    ? PROJECTS\n    : PROJECTS.filter(p => p.category === activeCategory);\n\n  return (\n    <div className=\"w-full relative min-h-screen pt-28 pb-16 flex flex-col justify-between\">\n      \n      {/* Page Header */}\n      <section className=\"max-w-7xl mx-auto px-6 md:px-12 w-full mt-8 md:mt-16 mb-16 text-left\">\n        <span className=\"font-sans text-xs md:text-sm text-royal-gold font-semibold tracking-[0.2em] mb-4 block uppercase p-1\">\n          Case Studies\n        </span>\n        <h1 className=\"font-display text-4xl sm:text-5xl lg:text-6xl font-black text-gray-900 dark:text-gilded-ivory leading-tight mb-6 max-w-4xl\">\n          Curating Visual Milestones and Digital Monuments\n        </h1>\n        <p className=\"font-sans text-base md:text-lg text-gray-600 dark:text-gray-300 max-w-2xl leading-relaxed\">\n          Each cases is a bespoke alignment of pristine visual composition and strategic code performance. Click any archive card below to summon a detailed case-study modal.\n        </p>\n      </section>\n\n      {/* Categories Filter Block */}\n      <section className=\"max-w-7xl mx-auto px-6 md:px-12 w-full mb-12\">\n        <div className=\"flex flex-wrap items-center gap-3 border-b border-royal-gold/10 pb-6 text-left\">\n          <div className=\"flex items-center gap-2 text-royal-gold mr-3\">\n            <Filter className=\"w-4 h-4 stroke-[1.5]\" />\n            <span className=\"font-sans text-xs font-bold uppercase tracking-widest\">Filter Archives</span>\n          </div>\n          {categories.map((cat) => {\n            const isActive = activeCategory === cat;\n            return (\n              <button\n                key={cat}\n                onClick={() => setActiveCategory(cat)}\n                className={`px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 cursor-pointer ${\n                  isActive \n                    ? \'bg-royal-gold text-deep-violet border-royal-gold shadow-md shadow-secondary/5\' \n                    : \'bg-white/40 dark:bg-black/10 border border-gray-200 dark:border-royal-gold/10 text-gray-600 dark:text-gray-400 hover:border-royal-gold\'\n                }`}\n              >\n                {cat}\n              </button>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* Grid Cases */}\n      <section className=\"max-w-7xl mx-auto px-6 md:px-12 w-full mb-16\">\n        <motion.div \n          layout\n          className=\"grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12\"\n        >\n          <AnimatePresence mode=\"popLayout\">\n            {filteredProjects.map((proj) => (\n              <motion.div\n                layout\n                key={proj.id}\n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, scale: 0.95 }}\n                transition={{ duration: 0.5 }}\n                whileHover={{ y: -6 }}\n                className=\"group relative rounded-[28px] border border-royal-gold/10 bg-white/60 dark:bg-zinc-950/20 shadow-2xl overflow-hidden cursor-pointer text-left flex flex-col justify-between\"\n                onClick={() => setSelectedProject(proj)}\n              >\n                {/* Visual Image container */}\n                <div className=\"relative aspect-video w-full overflow-hidden\">\n                  <img \n                    src={proj.image} \n                    alt={proj.title}\n                    referrerPolicy=\"no-referrer\"\n                    className=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-105\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-midnight-royal/60 via-transparent to-transparent opacity-80 group-hover:opacity-60 transition-opacity\" />\n                  \n                  {/* Absolute positioning tags */}\n                  <div className=\"absolute top-4 left-4 flex gap-2\">\n                    <span className=\"font-sans text-[9px] font-bold tracking-widest uppercase bg-midnight-royal text-royal-gold px-3 py-1 rounded-full border border-royal-gold/20 shadow-lg\">\n                      {proj.tag}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Info block */}\n                <div className=\"p-8 space-y-4\">\n                  <div className=\"flex justify-between items-start gap-3\">\n                    <div>\n                      <span className=\"font-sans text-[10px] text-royal-gold font-bold uppercase tracking-wider block\">\n                        {proj.category}\n                      </span>\n                      <h3 className=\"font-display text-2xl font-black text-gray-950 dark:text-gilded-ivory mt-1\">\n                        {proj.title}\n                      </h3>\n                    </div>\n                    <div className=\"p-2.5 bg-royal-gold/10 rounded-full text-royal-gold group-hover:bg-royal-gold group-hover:text-deep-violet transition-colors duration-300\">\n                      <ArrowUpRight className=\"w-4 h-4\" />\n                    </div>\n                  </div>\n\n                  <p className=\"font-sans text-xs md:text-sm text-gray-600 dark:text-gray-400 leading-relaxed line-clamp-2\">\n                    {proj.description}\n                  </p>\n\n                  <div className=\"flex justify-between items-center text-[11px] font-sans text-gray-400 pt-4 border-t border-royal-gold/10\">\n                    <span className=\"font-semibold text-royal-gold/80\">Client: {proj.client}</span>\n                    <span>Year: {proj.year}</span>\n                  </div>\n                </div>\n\n              </motion.div>\n            ))}\n          </AnimatePresence>\n        </motion.div>\n      </section>\n\n      {/* Precise Case Studies Lightbox Details Modal */}\n      <AnimatePresence>\n        {selectedProject && (\n          <motion.div \n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed inset-0 bg-black/80 backdrop-blur-md z-[100] flex items-center justify-center p-4 overflow-y-auto\"\n            onClick={() => setSelectedProject(null)}\n          >\n            <motion.div \n              initial={{ scale: 0.95, y: 15 }}\n              animate={{ scale: 1, y: 0 }}\n              exit={{ scale: 0.95, y: 15 }}\n              transition={{ duration: 0.4 }}\n              className=\"bg-white dark:bg-zinc-950 border border-royal-gold/25 rounded-[36px] w-full max-w-4xl overflow-hidden shadow-2xl max-h-[85vh] overflow-y-auto flex flex-col text-left\"\n              onClick={(e) => e.stopPropagation()}\n            >\n              {/* Cover Image Frame */}\n              <div className=\"relative aspect-video w-full select-none shrink-0 group\">\n                <img \n                  src={selectedProject.image} \n                  alt={selectedProject.title}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"w-full h-full object-cover grayscale-[0.1] group-hover:grayscale-0 transition-all duration-700\" \n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-midnight-royal/60 via-transparent to-transparent pointer-events-none\" />\n                \n                {/* Close Button */}\n                <button\n                  onClick={() => setSelectedProject(null)}\n                  className=\"absolute top-6 right-6 p-2 rounded-full bg-midnight-royal/80 hover:bg-midnight-royal text-royal-gold border border-royal-gold/25 hover:scale-105 active:scale-95 transition-all cursor-pointer shadow-lg\"\n                  title=\"Close Case Study\"\n                >\n                  <X className=\"w-5 h-5\" />\n                </button>\n\n                <div className=\"absolute bottom-6 left-6 right-6\">\n                  <span className=\"font-sans text-[10px] text-royal-gold font-bold uppercase tracking-[0.2em] bg-midnight-royal/85 px-3 py-1 rounded-full border border-royal-gold/20 inline-block shadow\">\n                    {selectedProject.tag}\n                  </span>\n                  <h2 className=\"font-display text-3xl sm:text-4xl md:text-5xl font-black text-gilded-ivory tracking-tight mt-3\">\n                    {selectedProject.title}\n                  </h2>\n                </div>\n              </div>\n\n              {/* Core Contents Grid */}\n              <div className=\"p-8 md:p-12 grid grid-cols-1 md:grid-cols-12 gap-10\">\n                \n                {/* Left side details */}\n                <div className=\"md:col-span-8 space-y-8\">\n                  <div className=\"space-y-4\">\n                    <div className=\"flex items-center gap-2 text-royal-gold\">\n                      <Target className=\"w-4 h-4 stroke-[1.5]\" />\n                      <span className=\"font-sans text-xs font-bold uppercase tracking-wider\">Project Narrative</span>\n                    </div>\n                    <p className=\"font-sans text-sm md:text-base text-gray-700 dark:text-gray-300 leading-relaxed\">\n                      {selectedProject.longDescription}\n                    </p>\n                  </div>\n\n                  {/* Objectives list */}\n                  <div className=\"space-y-4 pt-2\">\n                    <div className=\"flex items-center gap-2 text-royal-gold\">\n                      <Landmark className=\"w-4 h-4 stroke-[1.5]\" />\n                      <span className=\"font-sans text-xs font-bold uppercase tracking-wider\">The Strategic Mandate</span>\n                    </div>\n                    <div className=\"space-y-3\">\n                      {selectedProject.objectives.map((obj, idx) => (\n                        <div key={idx} className=\"flex items-start gap-3.5 text-xs md:text-sm text-gray-600 dark:text-gray-400\">\n                          <CheckCircle className=\"w-4.5 h-4.5 text-royal-gold shrink-0 mt-0.5\" />\n                          <span>{obj}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Right side metadata facts list */}\n                <div className=\"md:col-span-4 space-y-8 bg-off-white dark:bg-midnight-royal/60 p-6 md:p-8 border border-royal-gold/15 rounded-3xl h-fit\">\n                  \n                  {/* Basic Credentials Metadata */}\n                  <div className=\"space-y-5\">\n                    <h3 className=\"font-sans text-xs font-bold text-royal-gold uppercase tracking-widest pb-3 border-b border-royal-gold/10\">\n                      Credentials\n                    </h3>\n                    <div className=\"space-y-4 text-xs font-sans text-gray-600 dark:text-gray-400 text-left\">\n                      <div className=\"flex justify-between items-center gap-2\">\n                        <span>Client</span>\n                        <strong className=\"text-gray-900 dark:text-gilded-ivory\">{selectedProject.client}</strong>\n                      </div>\n                      <div className=\"flex justify-between items-center gap-2\">\n                        <span>Year</span>\n                        <strong className=\"text-gray-900 dark:text-gilded-ivory\">{selectedProject.year}</strong>\n                      </div>\n                      <div className=\"flex justify-between items-center gap-2\">\n                        <span>Domain</span>\n                        <strong className=\"text-gray-900 dark:text-gilded-ivory\">{selectedProject.category}</strong>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Metrics Deliverables */}\n                  <div className=\"space-y-4 pt-4 border-t border-royal-gold/10\">\n                    <h3 className=\"font-sans text-xs font-bold text-royal-gold uppercase tracking-widest inline-flex items-center gap-1.5 pb-1\">\n                      <TrendingUp className=\"w-3.5 h-3.5\" /> Key Benchmarks\n                    </h3>\n                    <ul className=\"space-y-3 text-xs md:text-xs text-gray-700 dark:text-gray-300\">\n                      {selectedProject.metrics.map((met, idx) => (\n                        <li key={idx} className=\"flex items-start gap-2 leading-relaxed font-semibold\">\n                          <span className=\"text-royal-gold font-display font-black text-xs\">\342\200\242</span>\n                          <span>{met}</span>\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n\n                  {/* Core physical deliverables */}\n                  <div className=\"space-y-4 pt-4 border-t border-royal-gold/10\">\n                    <h3 className=\"font-sans text-xs font-bold text-royal-gold uppercase tracking-widest pb-1\">\n                      Deliverables\n                    </h3>\n                    <ul className=\"space-y-2 text-xs text-gray-600 dark:text-gray-400\">\n                      {selectedProject.deliverables.map((del, idx) => (\n                        <li key={idx} className=\"flex items-center gap-2\">\n                          <span className=\"h-1.5 w-1.5 bg-royal-gold rounded-full\" />\n                          <span>{del}</span>\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n\n                </div>\n\n              </div>\n            </motion.div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n    </div>\n  );\n}\n"
    }
