        replacement_content: ":root {\n  --royal-gold-color: #2E1065; /* In light mode, yellow gold text/elements become deep purple */\n}\n\nhtml.dark {\n  --royal-gold-color: #D4AF37; /* In dark mode, it remains luxurious yellow gold */\n}\n\n/* Cascade gold accent down in dark containers to maintain premium styling and clear contrast in light mode */\n.bg-zinc-950,\n.bg-midnight-royal,\n.bg-[#0A0A0B],\n.bg-black,\n.bg-deep-violet,\n.bg-violet-950,\n.bg-zinc-900,\n#contact-footer,\n.dark-container {\n  --royal-gold-color: #D4AF37 !important;\n}\n\n@theme {\n  --font-display: \"Playfair Display\", serif;\n  --font-sans: \"Plus Jakarta Sans\", sans-serif;\n  \n  --color-royal-gold: var(--royal-gold-color);\n  --color-gilded-ivory: #FDFBF7;\n  --color-midnight-royal: #0A0A0B;\n  --color-deep-violet: #2E1065;\n  --color-off-white: #fcf8f9;\n}"
