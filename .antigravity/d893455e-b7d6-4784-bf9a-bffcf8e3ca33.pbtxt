        }
        lines {
          text: "        const dy = mousePosition.y - prev.y;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
